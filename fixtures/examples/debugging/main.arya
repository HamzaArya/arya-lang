use std "debug" as debug

const customer = {
  name: "Hamza",
  preferences: {notifications: false}
}

const notifications = customer?.preferences?.notifications ?? true
debug.assert(notifications == false, "An explicit false preference must be preserved.")

const tools = ["Arya", "Python", "JavaScript"]
  .slice(1)
  .join(" + ")

debug.trace("tools", tools)
print(debug.inspect({customer: customer.name, notifications: notifications, tools: tools}))
