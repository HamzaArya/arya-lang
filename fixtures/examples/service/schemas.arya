use std "validate" as validate

export const message = validate.object({
  message: validate.string({trim: true, min: 1, max: 1000})
})

export const greetingParams = validate.object({
  name: validate.string({trim: true, min: 1, max: 80})
})

export const greetingQuery = validate.object({
  punctuation: validate.optional(validate.enum(["!", "."]), "!")
})
