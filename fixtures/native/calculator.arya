use std "io" as io

fn calculate(a, operator, b) {
  if operator == "+" { return a + b }
  if operator == "-" { return a - b }
  if operator == "*" { return a * b }
  if operator == "/" {
    if b == 0 { throw "Cannot divide by zero" }
    return a / b
  }
  throw "Unknown operator"
}

if len(args) == 3 {
  try { print(calculate(number(args[0]), args[1], number(args[2]))) }
  catch error { print(error) }
} else {
  io.write("First number: ")
  let a = number(io.readLine())
  io.write("Operator (+ - * /): ")
  let operator = io.readLine()
  io.write("Second number: ")
  let b = number(io.readLine())
  try { print(calculate(a, operator, b)) }
  catch error { print(error) }
}
