let hits = 0

fn mark() {
  hits += 1
  return "unused"
}

keep missing = null
say(missing?.[mark()].value ?? "fallback")
say(missing?.method(mark()) ?? "skipped")
say(hits)

say(0 ?? 99, false ?? true, "" ?? "default")
say(null ?? undefined ?? 42)

keep user = {profile: {name: "Arya"}}
say(user
  ?.profile
  .name
  .toUpperCase())

let values = [1]
values?.push?.(2)
values?.["push"]?.(3)
say(values.join("-"))

keep absent = {}
say(absent.missing?.(mark()) ?? "no callback")

try { (missing?.value).next } catch error { say(error.name) }
try { {child: null}?.child.next } catch error { say(error.name) }
try { (7)?.() } catch error { say(error.name) }

fn choose() {
  if 0 ?? 1 { return 9 }
  return 7
}
say(choose())
