{
  "name": "arya-language",
  "version": "0.2.0-alpha.3",
  "private": false,
  "license": "Apache-2.0",
  "author": {
    "name": "Hamza Arya",
    "url": "https://hamzaarya.com"
  },
  "homepage": "https://hamzaarya.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HamzaArya/arya-lang.git"
  },
  "bugs": {
    "url": "https://github.com/HamzaArya/arya-lang/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "description": "Arya programming language: compiler API, CLI, language server, and editor support.",
  "engines": {
    "node": ">=22.15"
  },
  "main": "./dist/compiler.cjs",
  "types": "./dist/types/compiler.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/compiler.d.ts",
      "default": "./dist/compiler.cjs"
    },
    "./compiler": {
      "types": "./dist/types/compiler.d.ts",
      "default": "./dist/compiler.cjs"
    },
    "./language-service": {
      "types": "./dist/types/language-service.d.ts",
      "default": "./dist/language-service.cjs"
    },
    "./project": {
      "types": "./dist/types/project.d.ts",
      "default": "./dist/project.cjs"
    },
    "./cli": "./dist/cli.cjs",
    "./lsp": "./dist/lsp.cjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "arya": "dist/cli.cjs",
    "arya-lsp": "dist/lsp.cjs"
  },
  "files": [
    "dist",
    "docs",
    "fixtures",
    "brand",
    "editors",
    "README.md",
    "LICENSE",
    "NOTICE",
    "THIRD-PARTY-NOTICES.txt",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node scripts/test.mjs",
    "check": "npm run typecheck && npm test",
    "arya": "node dist/cli.cjs",
    "package": "npm run check && npm pack --pack-destination artifacts",
    "package:editors": "node scripts/package-editors.mjs",
    "test:package": "node scripts/test-package.mjs",
    "prepack": "npm run build",
    "release:check": "node scripts/check-release.mjs",
    "test:clean": "node scripts/verify-clean.mjs"
  },
  "devDependencies": {
    "@jridgewell/gen-mapping": "0.3.13",
    "@types/node": "22.20.5",
    "@types/vscode": "1.145.0",
    "@vscode/vsce": "3.6.2",
    "esbuild": "0.28.2",
    "fflate": "0.8.2",
    "typescript": "7.0.2",
    "vscode-languageserver": "9.0.1",
    "vscode-languageserver-textdocument": "1.0.12",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.2.0"
  }
}
