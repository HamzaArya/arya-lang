      if node.operator == "??" { condition = left + ".t==ANULL||" + left + ".t==AUNDEF" }
      emit(e, "if(" + condition + "){")
      let right = expr(e, node.right, env)
      emit(e, result + "=" + right + ";}")
      return result
    }
    let right = expr(e, node.right, env)
    location(e, node.token)
    return temp(e, "abin(" + quote(node.operator) + "," + left + "," + right + ")")
  }
  if node.kind == "member" {
    checkMemberExport(node.object, node.key, node.token)
    let object = expr(e, node.object, env)
    let key = expr(e, node.key, env)
    location(e, node.token)
    return temp(e, "aget(" + object + "," + key + ")")
  }
  if node.kind == "chain" {
    let result = temp(e, expr(e, node.base, env))
    let end = "chain" + str(e.labels); e.labels += 1
    let first = true
    for step in node.steps {
      if step.optional { emit(e, "if(" + result + ".t==ANULL||" + result + ".t==AUNDEF){" + result + "=av(AUNDEF);goto " + end + ";}") }
      if step.kind == "member" {
        if first { checkMemberExport(node.base, step.key, step.token) }
        let key = expr(e, step.key, env)
        location(e, step.token)
        let next = temp(e, "aget(" + result + "," + key + ")")
        emit(e, result + "=" + next + ";")
      } else {
        let items = []
        for arg in step.arguments { items.push(expr(e, arg, env)) }
        let data = "NULL"
        if len(items) > 0 { data = "(AV[]){" + items.join(",") + "}" }
        location(e, step.token)
        let next = temp(e, "acall(" + result + "," + str(len(items)) + "," + data + ")")
        emit(e, result + "=" + next + ";")
      }
      first = false
    }
    emit(e, end + ":;")
    return result
  }
  if node.kind == "function" {
    let id = makeFunction(e.unit, node)
    return temp(e, "afunction(" + id + "," + env + ",\"anonymous\")")
  }
  if node.kind == "call" {
    let callee = expr(e, node.callee, env)
    let items = []
    for arg in node.arguments { items.push(expr(e, arg, env)) }
    let data = "NULL"
    if len(items) > 0 { data = "(AV[]){" + items.join(",") + "}" }
    location(e, node.token)
    return temp(e, "acall(" + callee + "," + str(len(items)) + "," + data + ")")
  }
  fail(node.token, "Unsupported native expression.")
}
fn emitBlock(e, b, env) {
  let local = env
  if b.scope != null { local = enterScope(e, env, b.scope) }
  emitBody(e, b, local)
}
fn emitBody(e, b, env) {
  for s in b.statements {
    if s.kind == "function" {
      let id = makeFunction(e.unit, s.value)
      let value = temp(e, "afunction(" + id + "," + env + "," + quote(s.binding.name) + ")")
      temp(e, writeBinding(e, env, s.binding, value, 1))
    }
  }
  for s in b.statements { emitStatement(e, s, env) }
}
fn emitStatement(e, s, env) {
  location(e, s.token)
  if s.kind == "function" { return }
  if s.kind == "declaration" { let value = expr(e, s.value, env); temp(e, writeBinding(e, env, s.binding, value, 1)); return }
  if s.kind == "expression" { expr(e, s.value, env); return }
  if s.kind == "import" {
    let value = ""
    if s.bridge == "std" { value = temp(e, "astd(" + quote(s.specifier) + ")") }
    else { value = "ans[" + str(s.unit.id) + "]" }
    temp(e, writeBinding(e, env, s.binding, value, 1)); return
  }
  if s.kind == "assignment" {
    let t = s.target
    let old = null
    if t.kind == "name" {
      let b = binding(t)
      if has(["const", "import", "builtin"], b.kind) { fail(t.token, "Cannot assign to const '" + b.name + "'.") }
      if s.operator != "=" { old = temp(e, readBinding(e, env, b)) }
      let value = expr(e, s.value, env)
      if old != null { value = temp(e, "abin(" + quote(s.operator[0]) + "," + old + "," + value + ")") }
      temp(e, writeBinding(e, env, b, value, 0))
    } else {
      let object = expr(e, t.object, env)
      let key = expr(e, t.key, env)
      if s.operator != "=" { old = temp(e, "aget(" + object + "," + key + ")") }
      let value = expr(e, s.value, env)
      if old != null { value = temp(e, "abin(" + quote(s.operator[0]) + "," + old + "," + value + ")") }
      temp(e, "aset(" + object + "," + key + "," + value + ")")
    }
    return
  }
  if s.kind == "if" {
    let condition = expr(e, s.condition, env)
    emit(e, "if(atruth(" + condition + ")){"); emitBlock(e, s.body, env); emit(e, "}")
    if s.otherwise != null { emit(e, "else{"); emitBlock(e, s.otherwise, env); emit(e, "}") }
    return
  }
  if s.kind == "while" {
    emit(e, "for(;;){")
    let condition = expr(e, s.condition, env)
    emit(e, "if(!atruth(" + condition + "))break;"); emitBlock(e, s.body, env); emit(e, "}"); return
  }
  if s.kind == "for" {
    let header = enterScope(e, env, s.binding.scope)
    let iterable = expr(e, s.iterable, header)
    let position = temp(e, "an(0)")
    emit(e, "for(;;){")
    let item = temp(e, "aiternext(" + iterable + ",&" + position + ")")
    emit(e, "if(" + item + ".t==AUINIT)break;")
    let local = enterScope(e, env, s.binding.scope)
    temp(e, writeBinding(e, local, s.binding, item, 1)); emitBlock(e, s.body, local); emit(e, "}"); return
  }
  if s.kind == "return" {
    let value = "av(AUNDEF)"
    if s.value != null { value = expr(e, s.value, env) }
    emit(e, "result=" + value + ";goto done;"); return
  }
  if s.kind == "break" or s.kind == "continue" { emit(e, s.kind + ";"); return }
  if s.kind == "throw" {
    let value = expr(e, s.value, env); location(e, s.token)
    emit(e, "athrow(" + value + ");goto " + e.error + ";"); return
  }
  if s.kind == "try" {
    let id = str(e.labels); e.labels += 1
    let previous = e.error
    e.error = "catch" + id; emitBlock(e, s.body, env); e.error = previous
    emit(e, "goto after" + id + ";catch" + id + ":;")
    let thrown = "T[" + str(e.count) + "]"; e.count += 1
    emit(e, thrown + "=aerror;afailed=0;")
    let local = enterScope(e, env, s.handler.scope)
    temp(e, writeBinding(e, local, s.binding, thrown, 1)); emitBody(e, s.handler, local)
    emit(e, "after" + id + ":;"); return
  }
  fail(s.token, "Unsupported statement.")
}
fn emitter(unit, id) { return {unit: unit, id: id, count: 1, labels: 0, error: "failure", lines: []} }
fn finish(e, b, params, module) {
  emit(e, "T[0]=aenv(closure," + str(b.scope.id) + "," + str(len(b.scope.bindings)) + ");if(afailed)goto failure;")
  if module {
    emit(e, "amod[" + str(e.unit.id) + "]=T[0];ans[" + str(e.unit.id) + "]=arecord();")
    for builtin in b.scope.bindings {
      if builtin.kind == "builtin" {
        let ids = {print: 0, say: 0, len: 1, str: 2, number: 3, range: 4}
        let value = "aprogramArgs"
        if builtin.name != "args" { value = "abuilt(" + str(ids[builtin.name]) + ")" }
        temp(e, writeBinding(e, "T[0]", builtin, value, 1))
      }
    }
    for s in b.statements {
      if (s.kind == "function" or s.kind == "declaration") and s.exported {
        emit(e, "aaddexport(ans[" + str(e.unit.id) + "]," + quote(s.binding.name) + ",T[0]," + str(b.scope.id) + "," + str(s.binding.slot) + ");")
      }
    }
  }
  if module { emit(e, "ans[" + str(e.unit.id) + "].p->scope=-1;") }
  let i = 0
  for parameter in params {
    temp(e, writeBinding(e, "T[0]", parameter, "argc>" + str(i) + "?argv[" + str(i) + "]:av(AUNDEF)", 1)); i += 1
  }
  emitBody(e, b, "T[0]")
  let fast = e.fast or ""
  return "static AV " + e.id + "(AV closure,int argc,AV *argv){\n" + fast + "AV *T=(AV*)amemory(" + str(e.count) + "*sizeof(AV));AV result=av(AUNDEF);AFrame fr;fr.prev=aframes;fr.file=" + quote(e.unit.filename) + ";fr.name=" + quote(e.id) + ";fr.line=1;fr.column=1;aframes=&fr;aroot(&fr.roots,T," + str(e.count) + ");\n" + e.lines.join("\n") + "\ngoto done;failure:result=av(AUNDEF);done:aunroot(&fr.roots);aframes=fr.prev;free(T);return result;}\n"
}
fn numericExpr(node, allowed) {
  if node.kind == "literal" and node.token.kind == "number" {
    let text = str(node.value)
    if not text.includes(".") and not text.includes("e") { text += ".0" }
    return {code: text, numeric: true}
  }
  if node.kind == "name" {
    if has(["undefined", "NaN", "Infinity"], node.name) { return null }
    let b = binding(node)
    if allowed.includes(b) { return {code: "v" + str(b.scope.id) + "_" + str(b.slot), numeric: true} }
    return null
  }
  if node.kind == "unary" {
    let value = numericExpr(node.value, allowed)
    if value == null { return null }
    let op = node.operator
    if op == "not" { op = "!" }
    if op == "!" { return {code: "(!anumtruth(" + value.code + "))", numeric: false} }
    return {code: "(" + op + value.code + ")", numeric: true}
  }
  if node.kind == "binary" and node.operator != "and" and node.operator != "or" and node.operator != "??" {
    let left = numericExpr(node.left, allowed)
    let right = numericExpr(node.right, allowed)
    if left == null or right == null or not left.numeric or not right.numeric { return null }
    if node.operator == "**" { return {code: "apower(" + left.code + "," + right.code + ")", numeric: true} }
    if node.operator == "%" { return {code: "fmod(" + left.code + "," + right.code + ")", numeric: true} }
    return {code: "(" + left.code + node.operator + right.code + ")", numeric: has(["+", "-", "*", "/"], node.operator)}
  }
  return null
}
fn numericBody(block, state) {
  for s in block.statements {
    if not state.valid { return }
    if s.kind == "declaration" {
      let value = numericExpr(s.value, state.allowed)
      if value == null or not value.numeric { state.valid = false; return }
      state.allowed.push(s.binding)
      state.lines.push("double v" + str(s.binding.scope.id) + "_" + str(s.binding.slot) + "=" + value.code + ";")
    } else if s.kind == "assignment" and s.target.kind == "name" {
      let b = binding(s.target)
      let value = numericExpr(s.value, state.allowed)
      if value == null or not value.numeric or not state.allowed.includes(b) or b.kind == "const" { state.valid = false; return }
      state.lines.push("v" + str(b.scope.id) + "_" + str(b.slot) + s.operator + value.code + ";")
    } else if s.kind == "return" and s.value != null {
      let value = numericExpr(s.value, state.allowed)
      if value == null or not value.numeric { state.valid = false; return }
      state.lines.push("return " + value.code + ";")
    } else if s.kind == "while" or s.kind == "if" {
      let value = numericExpr(s.condition, state.allowed)
      if value == null { state.valid = false; return }
      state.lines.push(s.kind + "(anumtruth(" + value.code + ")){")
      numericBody(s.body, state); state.lines.push("}")
      if s.kind == "if" and s.otherwise != null { state.lines.push("else{"); numericBody(s.otherwise, state); state.lines.push("}") }
    } else { state.valid = false }
  }
}
fn specialize(node, id) {
  if len(node.body.statements) == 0 or node.body.statements[len(node.body.statements) - 1].kind != "return" { return null }
  let state = {valid: true, allowed: [], lines: []}
  let params = []
  for b in node.params { state.allowed.push(b); params.push("double v" + str(b.scope.id) + "_" + str(b.slot)) }
  numericBody(node.body, state)
  if not state.valid { return null }
  let name = id + "_numeric"
  let signature = params.join(",")
  if signature == "" { signature = "void" }
  definitions.push("static double " + name + "(" + signature + "){\n" + state.lines.join("\n") + "\n}")
  let guard = "argc>=" + str(len(node.params))
  let values = []
  let i = 0
  for b in node.params { guard += "&&argv[" + str(i) + "].t==ANUM"; values.push("argv[" + str(i) + "].n"); i += 1 }
  return "if(" + guard + ")return an(" + name + "(" + values.join(",") + "));\n"
}

fn makeFunction(unit, node) {
  if node.fid != undefined { return node.fid }
  let id = "afn" + str(functionCounter); functionCounter += 1
  node.fid = id
  prototypes.push("static AV " + id + "(AV,int,AV*);")
  let generator = emitter(unit, id)
  generator.fast = specialize(node, id)
  definitions.push(finish(generator, node.body, node.params, false))
  return id
}
fn generate() {
  let modules = []
  for unit in units { modules.push(finish(emitter(unit, "amodule" + str(unit.id)), unit.ast, [], true)) }
  let text = "/* Generated by Arya " + VERSION + "; self-hosted native compiler. */\n" + runtime_source.source + "\nstatic AV amod[" + str(len(units)) + "],ans[" + str(len(units)) + "],aprogramArgs;\n"
  text += prototypes.join("\n") + "\n" + definitions.join("\n") + "\n" + modules.join("\n")
  text += "\nint main(int argc,char **argv){ARoot modules,names,argsRoot;aroot(&modules,amod," + str(len(units)) + ");aroot(&names,ans," + str(len(units)) + ");aroot(&argsRoot,&aprogramArgs,1);aprogramArgs=alist(0,NULL);for(int i=1;i<argc;i++){AV value=astr(argv[i]);aresize(aprogramArgs.p,aprogramArgs.p->len+1);aprogramArgs.p->data[aprogramArgs.p->len++]=value;}\n"
  for unit in units { text += "amodule" + str(unit.id) + "(av(AUNDEF),0,NULL);if(afailed)goto finished;\n" }
  text += "finished:;int status=areport();aunroot(&argsRoot);aunroot(&names);aunroot(&modules);afailed=0;agc();return status;}\n"
  return text
}
fn main() {
  if len(args) == 1 and args[0] == "--version" { print("Arya native " + VERSION + " (self-hosted)"); return }
  if len(args) < 2 or not has(["check", "build", "run"], args[0]) {
    print("Arya native " + VERSION + " — self-hosted C11 compiler")
    print("arya-native check|build|run source.arya [-o executable] [-- program arguments]")
    return
  }
  let command = args[0]
  let filename = path.realPath(args[1])
  projectRoot = path.dirname(filename)
  let output = path.join(projectRoot, ".arya", "native", path.basename(filename).slice(0, -5))
  let compiler = process.env("ARYA_CC") or process.env("CC") or "cc"
  let programArgs = []
  let mode = "-O2"
  let i = 2
  while i < len(args) {
    let option = args[i]
    if option == "--" { programArgs = args.slice(i + 1); break }
    if option == "-o" or option == "--output" { i += 1; if i >= len(args) { throw "-o requires a path." } output = path.resolve(args[i]) }
    else if option == "--cc" { i += 1; if i >= len(args) { throw "--cc requires a compiler." } compiler = args[i] }
    else if option == "--debug" { mode = "-O0" }
    else if option == "--release" { mode = "-O2" }
    else if option == "--target" { i += 1; if args[i] != "native" { throw "Self-hosted Arya supports --target native." } }
    else { throw "Unknown compiler option: " + option }
    i += 1
  }
  load(filename, [])
  let code = generate()
  if command == "check" { print("Check OK (native): " + filename); return }
  for unit in loaded { if output == unit.filename { throw "Output cannot replace source." } }
  fs.makeDirectory(path.dirname(output))
  let stage = fs.tempDirectory(output + ".arya-XXXXXX")
  let cfile = path.join(stage, "program.c")
  let staged = path.join(stage, "program")
  fs.writeText(cfile, code)
  let status = process.run([compiler, "-std=c11", mode, "-ffp-contract=off", cfile, "-o", staged, "-lm"])
  if status != 0 { fs.remove(cfile); fs.removeDirectory(stage); process.exit(status) }
  fs.rename(staged, output)
  fs.rename(cfile, output + ".c")
  fs.removeDirectory(stage)
  if command == "build" { print(output); return }
  let invocation = [output]
  for argument in programArgs { invocation.push(argument) }
  process.exit(process.run(invocation))
}
try { main() }
catch error {
  if error.message != undefined { print("Compile error: " + error.message + " at " + str(error.line) + ":" + str(error.column)) }
  else { print("Compile error: " + str(error)) }
  process.exit(1)
}
