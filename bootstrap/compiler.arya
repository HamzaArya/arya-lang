use std "fs" as fs
use std "path" as path
use std "process" as process
use std "runtime" as runtime
use arya "./runtime-source.arya" as runtime_source

const VERSION = "1.2.0-alpha.4"
let scopeCounter = 0
let functionCounter = 0
let definitions = []
let prototypes = []
let units = []
let projectRoot = ""

fn fail(token, message) {
  throw {message: message, line: token.line + 1, column: token.column + 1}
}
fn has(items, item) { return items.includes(item) }
fn quote(text) {
  let result = '"'
  for c in text {
    if c == '"' { result += '\\"' }
    else if c == "\\" { result += "\\\\" }
    else if c == "\n" { result += "\\n" }
    else if c == "\r" { result += "\\r" }
    else if c == "\t" { result += "\\t" }
    else { result += c }
  }
  return result + '"'
}
fn tokenize(source) {
  let tokens = []
  let i = 0
  let line = 0
  let column = 0
  while i < len(source) {
    let c = source[i]
    if c == " " or c == "\t" or c == "\r" { i += 1; column += 1; continue }
    if c == "#" or source.slice(i, i + 2) == "//" {
      while i < len(source) and source[i] != "\n" { i += 1; column += 1 }
      continue
    }
    let token = {kind: "symbol", text: c, value: c, start: i, line: line, column: column}
    if c == "\n" { token.kind = "newline"; line += 1; column = 0; i += 1 }
    else if "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz_".includes(c) {
      token.kind = "word"
      let start = i
      while i < len(source) and "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz_0123456789".includes(source[i]) { i += 1; column += 1 }
      token.text = source.slice(start, i)
      token.value = token.text
      if token.text.slice(0, 6) == "__arya" { fail(token, "Names starting with __arya are reserved.") }
    } else if "0123456789".includes(c) {
      token.kind = "number"
      let start = i
      while i < len(source) and "0123456789".includes(source[i]) { i += 1; column += 1 }
      if source[i] == "." and i + 1 < len(source) and "0123456789".includes(source[i + 1]) {
        i += 1; column += 1
        while i < len(source) and "0123456789".includes(source[i]) { i += 1; column += 1 }
      }
      if source[i] == "e" or source[i] == "E" {
        i += 1; column += 1
        if source[i] == "+" or source[i] == "-" { i += 1; column += 1 }
        let digits = i
        while i < len(source) and "0123456789".includes(source[i]) { i += 1; column += 1 }
        if i == digits { fail(token, "Expected exponent digits.") }
      }
      token.text = source.slice(start, i)
      token.value = number(token.text)
      if token.value == Infinity { fail(token, "Number is outside the supported range.") }
    } else if (c == '"' or c == "'") and source.slice(i, i + 3) == c + c + c {
      token.kind = "string"
      let close = c + c + c
      i += 3; column += 3
      let start = i
      while i < len(source) and source.slice(i, i + 3) != close {
        if source[i] == "\n" { line += 1; column = 0 } else { column += 1 }
        i += 1
      }
      if i >= len(source) { fail(token, "Unclosed multiline string.") }
      token.text = source.slice(start, i); token.value = token.text
      i += 3; column += 3
    } else if c == '"' or c == "'" {
      token.kind = "string"
      let close = c
      i += 1; column += 1
      let value = ""
      while i < len(source) and source[i] != close {
        c = source[i]
        if c == "\n" { fail(token, "Close the string before the end of the line.") }
        if c == "\\" {
          i += 1; column += 1
          c = source[i]
          if c == "n" { c = "\n" }
          else if c == "r" { c = "\r" }
          else if c == "t" { c = "\t" }
          else if c != "\\" and c != '"' and c != "'" { fail(token, "Unsupported escape.") }
        }
        value += c; i += 1; column += 1
      }
      if i >= len(source) { fail(token, "Unclosed string.") }
      i += 1; column += 1; token.text = value; token.value = value
    } else {
      let pair = source.slice(i, i + 2)
      if has(["==", "!=", "<=", ">=", "+=", "-=", "*=", "/=", "**", "??", "?."], pair) { token.text = pair; i += 2; column += 2 }
      else if "+-*/%<>=!(){}[],:;.".includes(c) { i += 1; column += 1 }
      else { fail(token, "Unexpected source character.") }
    }
    tokens.push(token)
    if len(tokens) > 50000 { fail(token, "Source exceeds 50000 tokens.") }
  }
  tokens.push({kind: "eof", text: "", value: "", start: i, line: line, column: column})
  return tokens
}
fn current(p) { return p.tokens[p.at] }
fn is(p, text) { return current(p).kind != "string" and current(p).text == text }
fn take(p) { let token = current(p); p.at += 1; return token }
fn match(p, text) { if is(p, text) { take(p); return true } return false }
fn expect(p, text) { if not match(p, text) { fail(current(p), "Expected '" + text + "'.") } }
fn lines(p) { while current(p).kind == "newline" { take(p) } }
fn separators(p) { while current(p).kind == "newline" or is(p, ";") { take(p) } }
fn ending(p) {
  if current(p).kind == "eof" or is(p, "}") { return }
  if current(p).kind != "newline" and not is(p, ";") { fail(current(p), "Put the next statement on a new line or use a semicolon.") }
  separators(p)
}
const reserved = ["let", "const", "fn", "async", "await", "return", "if", "else", "for", "in", "while", "break", "continue", "and", "or", "not", "true", "false", "null", "use", "as", "export", "new", "try", "catch", "throw", "keep", "task", "when", "otherwise", "each", "give", "class", "function", "var", "import", "extends", "super", "this", "delete", "typeof", "void", "instanceof", "switch", "case", "default", "do", "finally", "yield", "with", "debugger", "enum", "implements", "interface", "package", "private", "protected", "public", "static", "arguments", "eval"]
fn name(p) {
  let token = current(p)
  if token.kind != "word" or has(reserved, token.text) { fail(token, "Expected a name.") }
  return take(p)
}
fn scope(parent) { scopeCounter += 1; return {id: scopeCounter, parent: parent, bindings: []} }
fn declare(p, token, kind) {
  for b in p.scope.bindings { if b.name == token.text { fail(token, "Duplicate name '" + token.text + "'.") } }
  let b = {name: token.text, kind: kind, scope: p.scope, slot: len(p.scope.bindings), token: token}
  p.scope.bindings.push(b)
  return b
}
fn binding(node) {
  let s = node.scope
  while s != null {
    for b in s.bindings { if b.name == node.name { return b } }
    s = s.parent
  }
  fail(node.token, "Unknown or unsupported native name '" + node.name + "'.")
}
fn block(p, existing) {
  lines(p); expect(p, "{")
  let previous = p.scope
  if existing != null { p.scope = existing } else { p.scope = scope(previous) }
  let b = {scope: p.scope, statements: []}
  separators(p)
  while not is(p, "}") {
    if current(p).kind == "eof" { fail(current(p), "Expected '}' to close block.") }
    b.statements.push(statement(p)); separators(p)
  }
  expect(p, "}"); p.scope = previous
  return b
}
fn functionValue(p, token) {
  expect(p, "("); lines(p)
  let previous = p.scope
  let s = scope(previous)
  p.scope = s
  let params = []
  if not is(p, ")") {
    while true {
      lines(p); if is(p, ")") { break }
      params.push(declare(p, name(p), "parameter")); lines(p)
      if not match(p, ",") { break }
    }
  }
  expect(p, ")"); p.scope = previous
  let loops = p.loops
  p.loops = 0; p.functions += 1
  let body = block(p, s)
  p.functions -= 1; p.loops = loops
  return {kind: "function", token: token, params: params, body: body}
}
fn argsList(p, close) {
  let items = []; lines(p)
  if not is(p, close) {
    while true {
      lines(p); if is(p, close) { break }
      items.push(expression(p, 0)); lines(p)
      if not match(p, ",") { break }
    }
  }
  expect(p, close); return items
}
fn primary(p) {
  let token = current(p)
  if is(p, "async") or is(p, "await") { fail(token, "async/await require the JavaScript profile.") }
  if match(p, "(") { lines(p); let value = expression(p, 0); lines(p); expect(p, ")"); return value }
  if match(p, "[") { return {kind: "list", token: token, items: argsList(p, "]")} }
  if match(p, "{") {
    let fields = []; lines(p)
    if not is(p, "}") {
      while true {
        lines(p); if is(p, "}") { break }
        let key = take(p)
        if key.kind != "word" and key.kind != "string" { fail(key, "Expected a record key.") }
        expect(p, ":"); lines(p); fields.push({key: key.text, value: expression(p, 0)}); lines(p)
        if not match(p, ",") { break }
      }
    }
    expect(p, "}"); return {kind: "object", token: token, fields: fields}
  }
  if match(p, "fn") or match(p, "task") { return functionValue(p, token) }
  if token.kind == "string" or token.kind == "number" { take(p); return {kind: "literal", token: token, value: token.value} }
  if match(p, "true") { return {kind: "literal", token: token, value: true} }
  if match(p, "false") { return {kind: "literal", token: token, value: false} }
  if match(p, "null") { return {kind: "literal", token: token, value: null} }
  if token.kind == "word" and not has(reserved, token.text) {
    take(p)
    return {kind: "name", token: token, name: token.text, scope: p.scope}
  }
  fail(token, "Expected a value, name, or function.")
}
fn unary(p) {
  let token = current(p)
  if has(["not", "!", "-", "+"], token.text) and token.kind != "string" {
    take(p); return {kind: "unary", token: token, operator: token.text, value: unary(p)}
  }
  let value = primary(p)
  let chaining = false
  while true {
    if current(p).kind == "newline" {
      let next = p.at
      while p.tokens[next].kind == "newline" { next += 1 }
      if p.tokens[next].kind == "symbol" and has([".", "?."], p.tokens[next].text) { p.at = next }
      else { break }
    }
    let token = current(p)
    let optional = match(p, "?.")
    let step = null
    if match(p, "(") { step = {kind: "call", token: token, optional: optional, arguments: argsList(p, ")")} }
    else if not optional and match(p, ".") {
      let key = take(p); if key.kind != "word" { fail(key, "Expected a property name.") }
      step = {kind: "member", token: key, optional: false, key: {kind: "literal", token: key, type: "string", value: key.text}}
    } else if match(p, "[") {
      lines(p); let key = expression(p, 0); lines(p); expect(p, "]")
      step = {kind: "member", token: key.token, optional: optional, key: key}
    } else if optional {
      let key = take(p); if key.kind != "word" { fail(key, "Expected a property, index, or call after optional access.") }
      step = {kind: "member", token: key, optional: true, key: {kind: "literal", token: key, type: "string", value: key.text}}
    } else { break }
    if optional or chaining {
      if not chaining { value = {kind: "chain", token: step.token, base: value, steps: []}; chaining = true }
      value.steps.push(step)
    } else if step.kind == "call" { value = {kind: "call", token: value.token, callee: value, arguments: step.arguments} }
    else { value = {kind: "member", token: step.token, object: value, key: step.key} }
  }
  return value
}
const ranks = {"??": 0, or: 1, and: 2, "==": 3, "!=": 3, "<": 4, "<=": 4, ">": 4, ">=": 4, "+": 5, "-": 5, "*": 6, "/": 6, "%": 6, "**": 7}
fn expression(p, minimum) {
  p.depth += 1
  if p.depth > 100 { fail(current(p), "Expression nesting exceeds 100.") }
  let left = unary(p)
  while current(p).kind != "string" and ranks[current(p).text] != undefined and ranks[current(p).text] >= minimum {
    let operator = take(p); lines(p)
    let next = ranks[operator.text] + 1
    if operator.text == "**" { next -= 1 }
    left = {kind: "binary", token: operator, operator: operator.text, left: left, right: expression(p, next)}
  }
  p.depth -= 1; return left
}
fn statement(p) {
  let token = current(p)
  let exported = match(p, "export")
  if exported and (p.scope.parent != null or not has(["let", "const", "fn", "keep", "task"], current(p).text)) { fail(token, "Export a top-level declaration.") }
  if is(p, "let") or is(p, "const") or is(p, "keep") {
    let kind = take(p).text
    if kind == "keep" { kind = "const" }
    let b = declare(p, name(p), kind); expect(p, "="); lines(p)
    let value = expression(p, 0); ending(p)
    return {kind: "declaration", token: token, binding: b, value: value, exported: exported}
  }
  if match(p, "fn") or match(p, "task") {
    let b = declare(p, name(p), "function")
    return {kind: "function", token: token, binding: b, value: functionValue(p, token), exported: exported}
  }
  if match(p, "use") {
    if p.scope.parent != null { fail(token, "Imports must be top level.") }
    let bridge = take(p)
    if not has(["std", "arya"], bridge.text) { fail(bridge, "Native imports use std or arya.") }
    let module = take(p)
    if module.kind != "string" or module.text == "" { fail(module, "Expected a library path.") }
    if bridge.text == "std" and not has(["io", "fs", "math", "process", "path", "runtime"], module.text) { fail(module, "Unknown standard library.") }
    if bridge.text == "arya" and ((module.text.slice(0, 2) != "./" and module.text.slice(0, 3) != "../") or module.text.slice(-5) != ".arya" or module.text.includes("\\")) { fail(module, "Use a relative path ending in .arya.") }
    expect(p, "as"); let b = declare(p, name(p), "import"); ending(p)
    let imported = {kind: "import", token: token, bridge: bridge.text, specifier: module.text, binding: b}
    b.imported = imported
    return imported
  }
  if match(p, "if") or match(p, "when") {
    let condition = expression(p, 0); let body = block(p, null); let saved = p.at
    lines(p); let other = null
    if match(p, "else") or match(p, "otherwise") { lines(p); if is(p, "if") or is(p, "when") { other = {scope: null, statements: [statement(p)]} } else { other = block(p, null) } }
    else { p.at = saved }
    return {kind: "if", token: token, condition: condition, body: body, otherwise: other}
  }
  if match(p, "while") {
    let condition = expression(p, 0); p.loops += 1
    let body = block(p, null); p.loops -= 1
    return {kind: "while", token: token, condition: condition, body: body}
  }
  if match(p, "for") or match(p, "each") {
    let previous = p.scope
    p.scope = scope(previous)
    let b = declare(p, name(p), "loop"); expect(p, "in"); let iterable = expression(p, 0)
    p.loops += 1
    let bodyScope = scope(p.scope)
    let body = block(p, bodyScope)
    for item in body.scope.bindings { if item.name == b.name { fail(item.token, "Duplicate loop binding.") } }
    p.loops -= 1; p.scope = previous
    return {kind: "for", token: token, binding: b, iterable: iterable, body: body}
  }
  if match(p, "try") {
    let body = block(p, null); lines(p); expect(p, "catch")
    let parameter = name(p); let previous = p.scope
    p.scope = scope(previous); let b = declare(p, parameter, "catch"); let handlerScope = p.scope; p.scope = previous
    return {kind: "try", token: token, body: body, binding: b, handler: block(p, handlerScope)}
  }
  if match(p, "throw") { let value = expression(p, 0); ending(p); return {kind: "throw", token: token, value: value} }
  if match(p, "return") or match(p, "give") {
    if p.functions == 0 { fail(token, "Return requires a function.") }
    let value = null
    if current(p).kind != "newline" and current(p).kind != "eof" and not is(p, ";") and not is(p, "}") { value = expression(p, 0) }
    ending(p); return {kind: "return", token: token, value: value}
  }
  if is(p, "break") or is(p, "continue") {
    if p.loops == 0 { fail(token, "Loop control requires a loop.") }
