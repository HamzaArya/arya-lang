fn parse(source, filename) {
  if len(source) > 262144 { throw "Source exceeds 256 KiB." }
  let p = {tokens: tokenize(source), at: 0, scope: scope(null), loops: 0, functions: 0, depth: 0}
  let fake = {text: "", line: 0, column: 0, start: 0}
  for builtin in ["print", "say", "len", "str", "number", "range", "args"] {
    fake = {text: builtin, line: 0, column: 0, start: 0}
    declare(p, fake, "builtin")
  }
  let result = {scope: p.scope, statements: [], filename: filename}
  separators(p)
  while current(p).kind != "eof" { result.statements.push(statement(p)); separators(p) }
  return result
}
let loaded = []
let sourceBytes = 0
fn load(filename, active) {
  filename = path.realPath(filename)
  if filename != projectRoot and filename.slice(0, len(projectRoot) + 1) != projectRoot + "/" { throw "Module escapes the project root: " + filename }
  if active.includes(filename) { throw "Arya module cycle: " + filename }
  for unit in loaded { if unit.filename == filename { return unit } }
  if len(loaded) >= 1024 { throw "Project exceeds 1024 modules." }
  let source = fs.readText(filename)
  sourceBytes += len(source)
  if sourceBytes > 16777216 { throw "Project exceeds 16 MiB." }
  let unit = {filename: filename, ast: parse(source, filename), id: len(loaded)}
  loaded.push(unit); active.push(filename)
  for s in unit.ast.statements {
    if s.kind == "import" and s.bridge == "arya" { s.unit = load(path.resolve(path.dirname(filename), s.specifier), active) }
  }
  active.pop(); units.push(unit); return unit
}
fn emit(e, text) { e.lines.push(text) }
fn location(e, token) { emit(e, "fr.line=" + str(token.line + 1) + ";fr.column=" + str(token.column + 1) + ";") }
fn temp(e, code) {
  let name = "T[" + str(e.count) + "]"; e.count += 1
  emit(e, name + "=" + code + ";")
  emit(e, "if(afailed)goto " + e.error + ";")
  return name
}
fn readBinding(e, env, b) { return "agetvar(" + env + "," + str(b.scope.id) + "," + str(b.slot) + ")" }
fn writeBinding(e, env, b, value, initialize) {
  return "asetvar(" + env + "," + str(b.scope.id) + "," + str(b.slot) + "," + value + "," + str(initialize) + ")"
}
fn enterScope(e, parent, s) { return temp(e, "aenv(" + parent + "," + str(s.id) + "," + str(len(s.bindings)) + ")") }
fn literalString(e, text) {
  let codes = []
  let i = 0
  while i < len(text) { codes.push(str(runtime.codeUnit(text, i))); i += 1 }
  let data = codes.join(",")
  if data == "" { data = "0" }
  return temp(e, "as16((const uint16_t[]){" + data + "}," + str(len(text)) + ")")
}
fn checkMemberExport(object, key, token) {
  if object.kind == "name" and (key.type == "string" or key.token.kind == "string") {
    let b = binding(object)
    if b.kind == "import" and b.imported.bridge == "arya" {
      let found = false
      for item in b.imported.unit.ast.statements { if (item.kind == "declaration" or item.kind == "function") and item.exported and item.binding.name == key.value { found = true } }
      if not found { fail(token, "Module does not export '" + key.value + "'.") }
    }
  }
}
fn expr(e, node, env) {
  location(e, node.token)
  if node.kind == "literal" {
    if node.token.kind == "string" or node.type == "string" { return literalString(e, node.value) }
    if node.token.kind == "number" {
      let text = str(node.value)
      if not text.includes(".") and not text.includes("e") and not text.includes("E") { text += ".0" }
      return "an(" + text + ")"
    }
    if node.value == null { return "av(ANULL)" }
    if node.value { return "ab(1)" }
    return "ab(0)"
  }
  if node.kind == "name" {
    if node.name == "undefined" or node.name == "NaN" or node.name == "Infinity" {
      let s = node.scope
      let shadow = false
      while s != null { for b in s.bindings { if b.name == node.name { shadow = true } } s = s.parent }
      if not shadow { if node.name == "undefined" { return "av(AUNDEF)" } if node.name == "NaN" { return "an(NAN)" } return "an(INFINITY)" }
    }
    return temp(e, readBinding(e, env, binding(node)))
  }
  if node.kind == "list" {
    let items = []
    for value in node.items { items.push(expr(e, value, env)) }
    let data = "NULL"
    if len(items) > 0 { data = "(AV[]){" + items.join(",") + "}" }
    return temp(e, "alist(" + str(len(items)) + "," + data + ")")
  }
  if node.kind == "object" {
    let object = temp(e, "arecord()")
    for field in node.fields {
      let key = literalString(e, field.key)
      let value = expr(e, field.value, env)
      temp(e, "aset(" + object + "," + key + "," + value + ")")
    }
    return object
  }
  if node.kind == "unary" {
    let value = expr(e, node.value, env)
    location(e, node.token)
    return temp(e, "aunary(" + quote(node.operator) + "," + value + ")")
  }
  if node.kind == "binary" {
    let left = expr(e, node.left, env)
    if node.operator == "and" or node.operator == "or" or node.operator == "??" {
      let result = temp(e, left)
      let invert = ""
      if node.operator == "or" { invert = "!" }
