# Server logic stays in Arya; index.html and public/ contain the website.
use std "web" as web
use std "python" as python
use python "statistics" as statistics

fn total(values) {
  let result = 0
  for value in values {
    result += value
  }
  return result
}

const port = number(args[0] or "3000")
const server = web.serve(port, {
  "POST /api/calculate": fn(request) {
    if not request.body or not Array.isArray(request.body.values) or len(request.body.values) == 0 {
      return web.response(400, {error: "Supply a nonempty values list"})
    }
    const values = request.body.values
    for value in values {
      if not Number.isFinite(value) {
        return web.response(400, {error: "Every value must be a finite number"})
      }
    }
    const sum = total(values)
    return {count: len(values), total: sum, average: sum / len(values)}
  },
  "GET /api/python": async fn(request) {
    const stats = python.bind(statistics, {signal: request.signal})
    return {source: "Python statistics", mean: await stats.mean([10, 20, 30])}
  }
})
server.on("listening", fn() {
  print("Arya Studio: http://127.0.0.1:" + str(server.address().port))
})
