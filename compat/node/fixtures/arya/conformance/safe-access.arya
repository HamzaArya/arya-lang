let hits = 0

fn mark() {
  hits += 1
  return "unused"
}

const missing = null
print(missing?.[mark()].value ?? "fallback")
print(missing?.method(mark()) ?? "skipped")
print(hits)

print(0 ?? 99, false ?? true, "" ?? "default")
print(null ?? undefined ?? 42)

const user = {profile: {name: "Arya"}}
print(user
  ?.profile
  .name
  .toUpperCase())

let values = [1]
values?.push?.(2)
values?.["push"]?.(3)
print(values.join("-"))

const absent = {}
print(absent.missing?.(mark()) ?? "no callback")

try { (missing?.value).next } catch error { print(error.name) }
try { {child: null}?.child.next } catch error { print(error.name) }
try { (7)?.() } catch error { print(error.name) }

fn choose() {
  if 0 ?? 1 { return 9 }
  return 7
}
print(choose())
