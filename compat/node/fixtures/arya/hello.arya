# Readable code with familiar building blocks.
fn greet(name) {
  return "Hello, " + name + "!"
}

let names = ["Arya", "JavaScript", "Python"]
for name in names {
  print(greet(name))
}

let total = 0
for value in range(1, 6) {
  total += value
}
if total == 15 and len(names) == 3 {
  print("Ready to build. Total:", total)
}
