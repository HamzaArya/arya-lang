+#!/usr/bin/env python3
+"""Optional controller guardrails: preserve evidence, reject drift and contention."""
+import fcntl
+import json
+from pathlib import Path
+import runpy
+import subprocess
+import sys
+import tempfile
+import unittest
+
+controller = Path(__file__).parents[1] / "benchmarks/journal.py"
+guard = runpy.run_path(str(controller))
