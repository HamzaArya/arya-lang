#!/bin/sh
# Source-checkout launcher for the independent native compiler.
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if test ! -x "$root/.build/independent/arya"; then
  printf '%s\n' 'Build the native compiler first: make native' >&2
  exit 1
fi
exec "$root/.build/independent/arya" "$@"
