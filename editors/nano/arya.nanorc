syntax "arya" "\.arya$"
comment "#"
color magenta "\<(let|const|fn|async|await|return|if|else|for|in|while|break|continue|and|or|not|use|as|export|new|try|catch|throw)\>"
color cyan "\<(print|len|range|str|number|args)\>"
color yellow "\<(true|false|null)\>"
color yellow "\<[0-9]+(\.[0-9]+)?([eE][+-]?[0-9]+)?\>"
color green "\"([^\"\\]|\\.)*\"|'([^'\\]|\\.)*'"
color brightblack "(#|//).*$"
