{
  "Function": {
    "prefix": "fn",
    "body": [
      "fn ${1:name}(${2:values}) {",
      "  ${0:return values}",
      "}"
    ]
  },
  "Async function": {
    "prefix": [
      "async",
      "asyncfn"
    ],
    "body": [
      "async fn ${1:name}(${2:values}) {",
      "  ${0:return values}",
      "}"
    ]
  },
  "For each": {
    "prefix": "for",
    "body": [
      "for ${1:item} in ${2:items} {",
      "  $0",
      "}"
    ]
  },
  "Condition": {
    "prefix": "if",
    "body": [
      "if ${1:condition} {",
      "  $0",
      "}"
    ]
  },
  "Python library": {
    "prefix": "usepy",
    "body": "use python \"${1:math}\" as ${2:math}"
  },
  "Print": {
    "prefix": "print",
    "body": "print($0)"
  },
  "Arya namespace import": {
    "prefix": "usearya",
    "body": [
      "use arya \"${1:./module.arya}\" as ${2:module}"
    ],
    "description": "Import an Arya module namespace"
  },
  "Arya constant": {
    "prefix": "const",
    "body": "const ${1:name} = ${0:value}",
    "description": "Declare a constant binding"
  },
  "Arya decision": {
    "prefix": "ifelse",
    "body": [
      "if ${1:condition} {",
      "  $2",
      "} else {",
      "  $0",
      "}"
    ],
    "description": "Choose a branch with if / else"
  },
  "Arya view": {
    "prefix": "view",
    "body": [
      "view {",
      "  html {",
      "    head { title \"${1:My Arya app}\" }",
      "    body {",
      "      h1 \"${2:Hello from Arya}\"",
      "      $0",
      "    }",
      "  }",
      "}"
    ],
    "description": "Create an HTML view (JavaScript target)"
  },
  "Arya CSS": {
    "prefix": "style",
    "body": [
      "style \"\"\"",
      "  ${0:body { font-family: system-ui; \\}}",
      "\"\"\""
    ],
    "description": "Embed literal CSS in a view"
  },
  "Arya browser script": {
    "prefix": "script",
    "body": [
      "script \"\"\"",
      "  $0",
      "\"\"\""
    ],
    "description": "Embed browser JavaScript in a view"
  },
  "Arya standard library": {
    "prefix": "usestd",
    "body": "use std \"${1|web,fs,math,json,path,mysql,env,validate,log,python,debug,ui|}\" as ${2:library}",
    "description": "Import a standard library for the selected execution profile"
  },
  "Arya web application": {
    "prefix": "webapp",
    "body": [
      "use std \"web\" as web",
      "",
      "web.serve(${1:3000}, {",
      "  \"GET /api/health\": fn() {",
      "    return {status: \"ok\"}",
      "  }",
      "})",
      "$0"
    ],
    "description": "Serve index.html and public assets with an Arya API route (JavaScript target)"
  },
  "Arya inline web application": {
    "prefix": "webinline",
    "body": [
      "use std \"web\" as web",
      "",
      "const home = view {",
      "  html {",
      "    head { title \"${1:My Arya app}\" }",
      "    body { h1 \"${2:Hello from Arya}\" }",
      "  }",
      "}",
      "",
      "web.serve(${3:3000}, {\"/\": home}, {html: false})",
      "$0"
    ],
    "description": "Serve an optional inline view without an HTML entry (JavaScript target)"
  },
  "MySQL connection": {
    "prefix": "mysqlconnect",
    "body": [
      "use std \"env\" as env",
      "use std \"mysql\" as mysql",
      "",
      "const ${1:db} = await mysql.connect({",
      "  host: env.get(\"DB_HOST\", \"127.0.0.1\"),",
      "  user: env.require(\"DB_USER\"),",
      "  password: env.get(\"DB_PASSWORD\", \"\"),",
      "  database: env.require(\"DB_NAME\")",
      "})",
      "$0"
    ],
    "description": "Open and verify a MySQL pool using environment configuration"
  },
  "MySQL prepared query": {
    "prefix": "mysqlrows",
    "body": [
      "const ${1:rows} = await ${2:db}.rows(",
      "  \"${3:SELECT id, title FROM tasks WHERE completed = ?}\",",
      "  [${4:false}]",
      ")",
      "$0"
    ],
    "description": "Read rows with prepared values"
  },
  "MySQL transaction": {
    "prefix": "mysqltransaction",
    "body": [
      "const ${1:result} = await ${2:db}.transaction(async fn(tx) {",
      "  const saved = await tx.execute(",
      "    \"${3:INSERT INTO tasks (title) VALUES (?)}\",",
      "    [${4:title}]",
      "  )",
      "",
      "  return saved",
      "})",
      "$0"
    ],
    "description": "Commit related writes together; roll back on failure"
  },
  "Return": {
    "prefix": "return",
    "body": "return $0",
    "description": "Return a value from a function"
  },
  "Validated request body": {
    "prefix": "validateschema",
    "body": [
      "const ${1:input} = validate.object({",
      "  ${2:title}: validate.string({trim: true, min: 1, max: 200})",
      "})",
      "$0"
    ],
    "description": "Define a strict request schema with normalized text"
  },
  "Validated API route": {
    "prefix": "webroute",
    "body": [
      "\"${1:POST /api/items}\": web.route(${2:createItem}, {",
      "  body: ${3:input}",
      "})",
      "$0"
    ],
    "description": "Validate a request before calling its handler"
  },
  "Structured logger": {
    "prefix": "logcreate",
    "body": [
      "use std \"log\" as log",
      "",
      "const ${1:logger} = log.create({",
      "  name: \"${2:my-service}\",",
      "  level: \"info\"",
      "})",
      "$0"
    ],
    "description": "Create a structured JSON logger with default credential-field redaction"
  },
  "Graceful HTTP shutdown": {
    "prefix": "webshutdown",
    "body": [
      "await web.shutdown(${1:server}, {",
      "  timeoutMs: 10000,",
      "  cleanup: async fn() {",
      "    await ${2:db}.close()",
      "  }",
      "})",
      "$0"
    ],
    "description": "Finish active requests before closing shared resources"
  },
  "Asynchronous Python import": {
    "prefix": "pythonasync",
    "body": [
      "use std \"python\" as python",
      "use python \"${1:statistics}\" as ${2:library}",
      "",
      "const ${3:asyncLibrary} = python.bind(${2:library})",
      "const ${4:result} = await ${3:asyncLibrary}.${5:mean}(${6:values})",
      "$0"
    ],
    "description": "Call Python with normal function syntax without blocking JavaScript"
  },
  "Managed Python client": {
    "prefix": "pythonclient",
    "body": [
      "const ${1:py} = python.client({",
      "  timeoutMs: 5000,",
      "  maxConcurrency: 4,",
      "  queueLimit: 32",
      "})",
      "$0"
    ],
    "description": "Bound concurrent Python work and queued requests"
  },
  "Python call with cancellation": {
    "prefix": "pythoncall",
    "body": [
      "const ${1:result} = await ${2:py}.call(${3:library.function}, [${4:value}], {",
      "  kwargs: {${5:option}: ${6:value}},",
      "  signal: ${7:request.signal}",
      "})",
      "$0"
    ],
    "description": "Call Python with keyword arguments and cancellation"
  },
  "Python batch mapping": {
    "prefix": "pythonmap",
    "body": "const ${1:results} = await ${2:python}.map(${3:library.function}, ${4:values})\n$0",
    "description": "Process a list in one Python invocation, preserving order"
  },
  "Safe nested value": {
    "prefix": "safevalue",
    "body": "const ${1:value} = ${2:object}?.${3:property} ?? ${4:fallback}\n$0",
    "description": "Use a default only when a value is null or undefined"
  },
  "Debug assertion": {
    "prefix": "debugassert",
    "body": "debug.assert(${1:condition}, \"${2:Explain the expected condition.}\")\n$0",
    "description": "Check an invariant with a mapped source location"
  },
  "Debug trace": {
    "prefix": "debugtrace",
    "body": "debug.trace(\"${1:label}\", ${2:value})\n$0",
    "description": "Inspect a value and its caller location on stderr"
  },
  "Arya interactive UI": {
    "prefix": "uipage",
    "body": [
      "use std \"ui\" as ui",
      "",
      "const page = ui.page({",
      "  title: \"${1:My app}\",",
      "  state: {count: 0},",
      "  body: ui.card([",
      "    ui.heading(\"${2:Hello from Arya}\"),",
      "    ui.text(ui.bind(\"count\"), {role: \"status\", \"aria-live\": \"polite\"}),",
      "    ui.button(\"Add one\", {action: ui.increment(\"count\")})",
      "  ], {animate: \"rise\"})",
      "})",
      "$0"
    ],
    "description": "Create an interactive Arya UI page with browser state and animation (JavaScript profile)"
  },
  "Arya UI preview": {
    "prefix": "uipreview",
    "body": "ui.preview({section: \"${1|components,motion,guide|}\", basePath: \"${2:/ui}\"})",
    "description": "Render the built-in UI library preview or implementation guide"
  },
  "Arya UI field": {
    "prefix": "uifield",
    "body": "ui.field(\"${1:Label}\", ui.input({id: \"${2:name}\", bind: \"${3:name}\"}), {hint: \"${4:Helpful context}\"})",
    "description": "Create a labelled input with an associated hint"
  },
  "Arya UI dialog": {
    "prefix": "uidialog",
    "body": [
      "ui.dialog(\"${1:confirm}\", \"${2:Confirm action}\", [",
      "  ui.text(\"${3:Continue?}\"),",
      "  ui.button(\"Continue\", {action: ui.close(\"${1:confirm}\")})",
      "])"
    ],
    "description": "Create a native modal dialog; open with ui.open(id)"
  },
  "Arya UI motion": {
    "prefix": "uimotion",
    "body": "ui.motion(\"${1|rise,fade,slide,scale,pulse,drop,slide-right,fade-out,zoom-out,bounce,shake,flip,spin,wiggle,blur,float|}\", {duration: ${2:600}, trigger: \"${3|load,hover,press,visible|}\"})",
    "description": "Configure a preset animation with timing and trigger"
  },
  "Arya UI keyframes": {
    "prefix": "uikeyframes",
    "body": [
      "ui.keyframes([",
      "  {opacity: 0, transform: \"translateY(24px)\"},",
      "  {opacity: 1, transform: \"translateY(0)\"}",
      "], {duration: ${1:700}, easing: \"${2|smooth,snappy,linear,ease,ease-in,ease-out,ease-in-out|}\"})"
    ],
    "description": "Create a validated custom keyframe animation"
  },
  "Expression function": {
    "prefix": "fnvalue",
    "body": "fn ${1:name}(${2:value}) => ${0:value}",
    "description": "Return an expression without a wrapper block"
  },
  "Function defaults and rest": {
    "prefix": "fnrest",
    "body": [
      "fn ${1:name}(${2:initial} = ${3:0}, ...${4:values}) {",
      "  ${0:return values}",
      "}"
    ],
    "description": "Default values and remaining positional arguments"
  },
  "Pipeline": {
    "prefix": "pipe",
    "body": "${1:value} |> ${2:transform}(${0:options})",
    "description": "Pass a value as the first argument of a function"
  },
  "Awaited pipeline": {
    "prefix": "pipeawait",
    "body": "${1:value} |> await ${0:transform}",
    "description": "Await one pipeline stage before continuing"
  },
  "Guard exit": {
    "prefix": "guard",
    "body": [
      "guard ${1:condition} else {",
      "  ${0:return null}",
      "}"
    ],
    "description": "Exit early when a required condition fails"
  },
  "Indexed iteration": {
    "prefix": "forindex",
    "body": [
      "for ${1:item} at ${2:index} in ${3:items} {",
      "  $0",
      "}"
    ],
    "description": "Iterate values with a zero-based position"
  },
  "Try finally": {
    "prefix": "tryfinally",
    "body": [
      "try {",
      "  $1",
      "} finally {",
      "  ${0:await resource.close()}",
      "}"
    ],
    "description": "Run cleanup after success, return, or failure"
  },
  "List spread": {
    "prefix": "spreadlist",
    "body": "[...${1:items}, ${0:nextItem}]",
    "description": "Compose a list from iterable values"
  },
  "UI hero section": {
    "prefix": "uihero",
    "body": [
      "ui.hero({",
      "  title: \"${1:Your next chapter}\",",
      "  description: \"${2:A clear place to begin.}\",",
      "  actions: [ui.link(\"${3:Get started}\", \"${4:/start}\")]",
      "})"
    ],
    "description": "Compose a spacious hero section"
  },
  "UI full-page template": {
    "prefix": "uitemplate",
    "body": "ui.template(\"${1|landing,dashboard,settings,sign-in|}\", {brand: \"${2:My workspace}\"})",
    "description": "Render a complete customizable HTML document"
  },
  "UI settings request": {
    "prefix": "uisettings",
    "body": [
      "ui.template(\"settings\", {",
      "  submitAction: ui.request(\"${1:/api/profile}\", {",
      "    method: \"POST\",",
      "    body: {name: ui.bind(\"name\"), email: ui.bind(\"email\"), notifications: ui.bind(\"notifications\")},",
      "    result: \"result\", error: \"problem\"",
      "  })",
      "})"
    ],
    "description": "Connect the settings template to your server route"
  },
  "UI segmented choices": {
    "prefix": "uisegmented",
    "body": "ui.segmented([{value: \"${1:personal}\", label: \"${2:Personal}\"}, {value: \"${3:team}\", label: \"${4:Team}\"}], {id: \"${5:plan}\", bind: \"${6:plan}\", label: \"${7:Choose a plan}\"})",
    "description": "Bind a native radio segment group to page state"
  }
}
