return ui.page({"title": ("Arya UI — " + section), "theme": "light", "css": "\nmain.arya-page { width:100%; max-width:none; padding:0; } .kit-shell { display:grid; grid-template-columns:235px minmax(0,1fr); min-height:100vh; } .kit-sidebar { position:sticky; top:0; height:100vh; padding:2rem 1.65rem; border-right:1px solid var(--line); display:flex; flex-direction:column; gap:2rem; background:var(--surface); } .kit-brand { font-size:1.7rem; font-weight:780; letter-spacing:-.09em; text-decoration:none; color:var(--ink); } .kit-brand span { color:var(--accent); } .kit-brand small { margin-left:.8rem; font-size:.7rem; letter-spacing:0; font-weight:500; color:var(--muted); } .kit-nav { display:flex; flex-direction:column; gap:.35rem; } .kit-nav a { display:block; padding:.65rem .8rem; border-radius:.4rem; color:var(--muted); text-decoration:none; font-size:.85rem; } .kit-nav a[aria-current=\"page\"] { color:var(--ink); background:var(--bg); font-weight:650; } .kit-sidebar .kit-bottom { margin-top:auto; font-size:.72rem; color:var(--muted); } .kit-content { width:100%; max-width:1240px; margin:0 auto; padding:2rem clamp(1.25rem,4vw,4.5rem) 5rem; min-width:0; } .kit-top { justify-content:space-between; padding-bottom:2.2rem; border-bottom:1px solid var(--line); margin-bottom:3rem; } .kit-top button { font-size:.75rem; padding:.45rem .7rem; } .kit-hero { gap:1.4rem; margin-bottom:3rem; } .kit-hero h1 { font-size:clamp(2.5rem,5.2vw,4.6rem); font-weight:550; max-width:18ch; line-height:1.06; } .kit-hero>p { max-width:44rem; font-size:.95rem; } .kit-summary { grid-template-columns:repeat(3,minmax(0,1fr)); padding:1.5rem 0; border-top:1px solid var(--line); border-bottom:1px solid var(--line); margin-bottom:3rem; } .kit-summary .arya-stat-value { font-size:1.65rem; } .kit-summary .arya-muted { font-size:.75rem; } .kit-section { gap:1.4rem; margin-bottom:2.5rem; scroll-margin-top:2rem; } .kit-section>h2 { font-size:1.8rem; font-weight:550; } .kit-demo { padding:1.5rem; min-width:0; background:var(--surface); } .kit-demo>h3 { font-size:1rem; font-weight:650; letter-spacing:-.02em; margin:0; } .kit-demo>p { font-size:.8rem; } .kit-demo .arya-tabs { margin-top:.25rem; } .kit-demo [role=\"tabpanel\"] { padding:.5rem 0; } .kit-example-head { justify-content:space-between; } .kit-example-head button { padding:.3rem .65rem; font-size:.7rem; } .kit-example-head small { color:var(--muted); font: .7rem ui-monospace,monospace; } .kit-live { min-height:8rem; justify-content:center; } .kit-counter { font-size:2.5rem; font-weight:600; font-variant-numeric:tabular-nums; } .kit-motion-grid { grid-template-columns:repeat(auto-fit,minmax(min(100%,14rem),1fr)); } .kit-motion-card { padding:1.1rem; } .kit-motion-stage { display:flex; align-items:center; justify-content:center; height:9rem; border:1px solid var(--line); border-radius:.65rem; background:var(--bg); overflow:hidden; } .kit-motion-object { display:flex; align-items:center; justify-content:center; width:3.6rem; height:3.6rem; border-radius:1rem; background:var(--accent); color:var(--button-ink); font-size:1.8rem; font-weight:750; letter-spacing:-.1em; box-shadow:0 .5rem 1.5rem #0001; } .kit-motion-label { justify-content:space-between; } .kit-motion-label strong { font-size:.85rem; } .kit-motion-card button { padding:.45rem .7rem; font-size:.75rem; } .kit-transport { padding:1.25rem; border:1px solid var(--line); border-radius:.75rem; } .kit-orbit { display:flex; align-items:center; justify-content:center; width:5rem; height:5rem; border:1px solid var(--accent); border-radius:1.25rem; color:var(--accent); font-size:2.5rem; margin:1rem auto; } .kit-stagger { display:grid; grid-template-columns:repeat(4,1fr); gap:.7rem; } .kit-stagger>div { border-radius:.5rem; padding:1rem; text-align:center; background:var(--accent); color:var(--button-ink); font-size:.75rem; font-weight:650; } .kit-guide-step { margin-bottom:1.5rem; } .kit-guide-step>h2 { font-size:1.3rem; letter-spacing:-.025em; } .kit-guide-ste