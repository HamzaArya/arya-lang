# Native HTTP services. The compiler binds static files to the importing source.
use std "_http" as transport
use std "path" as path
use std "fs" as fs
use std "runtime" as runtime
use std "validate" as validate
use std "list" as list

fn object(value, label) {
  if runtime.kind(value) != "record" or runtime.hasAccessor(value) { throw new TypeError(label + " must be a record with data fields.") }
