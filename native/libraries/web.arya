    })(key, checks[key]))
  }
  let results = await Promise.all(operations); let ready = true
  for result in results { if result[1] != "ok" { ready = false } }
  let status = "unready"; let number = 503
  if ready { status = "ready"; number = 200 }
  return response(number, {status: status, checks: Object.fromEntries(results)}, {"cache-control": "no-store"})
}
fn inside(root, file) { return file == root or file.startsWith(root + "/") or root == "/" and file.startsWith("/") }
fn contained(root, name, label) { if runtime.kind(name) != "string" or name.startsWith("/") or name.includes("\0") or name.includes("\\") { throw new TypeError(label + " must be relative to the web root.") }; let file = path.resolve(root, name); if not inside(root, file) { throw new TypeError(label + " must stay inside the web root.") }; return file }
fn matchesId(value) { if runtime.kind(value) != "string" or len(value) < 1 or len(value) > 128 { return false }; for c in value { if not "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789._:-".includes(c) { return false } }; return true }
fn parameterName(value) { if len(value) == 0 or not "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz_".includes(value[0]) { return false }; for c in value { if not "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz_0123456789".includes(c) { return false } }; return true }
fn patternsFor(routes) {
  let patterns = []; let identities = new Set()
  for key in Object.keys(routes) {
    let method = undefined; let pathname = key; let space = key.indexOf(" ")
    if space >= 0 { method = key.slice(0, space); pathname = key.slice(space + 1); if len(method) == 0 { throw new TypeError("Invalid route method.") }; for c in method { if not "ABCDEFGHIJKLMNOPQRSTUVWXYZ".includes(c) { throw new TypeError("Route methods must be uppercase.") } } }
    if not pathname.startsWith("/") or pathname.includes("?") or pathname.includes("#") { throw new TypeError("Route keys must be paths or METHOD /path: " + key) }
    let segments = pathname.split("/"); let names = new Set(); let identity = []; let score = 0
