}
fn integer(value, low, high, label) { if not Number.isSafeInteger(value) or value < low or value > high { throw new TypeError(label + " must be an integer from " + str(low) + " to " + str(high) + ".") }; return value }
fn timeout(value, label) { return integer(value, 1, 2147483647, label) }
fn codeText(value) { if runtime.kind(value) != "string" or len(value) < 1 or len(value) > 64 or not "ABCDEFGHIJKLMNOPQRSTUVWXYZ".includes(value[0]) { return false }; for c in value { if not "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_".includes(c) { return false } }; return true }
export fn error(status, message, code) {
