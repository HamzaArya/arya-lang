      }
      if matches { return {value: pattern.value, params: params} }
    }
  }
  return undefined
}
const mimeTypes = {html: "text/html; charset=utf-8", htm: "text/html; charset=utf-8", css: "text/css; charset=utf-8", js: "text/javascript; charset=utf-8", mjs: "text/javascript; charset=utf-8", json: "application/json; charset=utf-8", svg: "image/svg+xml", png: "image/png", jpg: "image/jpeg", jpeg: "image/jpeg", gif: "image/gif", ico: "image/x-icon", webp: "image/webp", wasm: "application/wasm", pdf: "application/pdf", mp4: "video/mp4", webm: "video/webm", mp3: "audio/mpeg", ogg: "audio/ogg"}
fn staticFile(state, raw) {
  let pathname = undefined
  try { pathname = decodeURIComponent(raw.split("?")[0].split("#")[0]) } catch _failure { throw error(400, "Invalid URL encoding") }
  if not pathname.startsWith("/") or pathname.includes("\\") or pathname.includes("\0") { throw error(400, "Invalid asset path") }
  for segment in pathname.split("/") { if segment.startsWith(".") { throw error(400, "Invalid asset path") } }
  let file = undefined; let boundary = undefined
  if pathname == "/" and state.index != undefined { file = state.index; boundary = state.root }
  else if state.assets != undefined {
    try { boundary = path.realPath(state.assets) } catch _failure { return undefined }
    if not inside(state.root, boundary) { return undefined }; file = path.resolve(boundary, "." + pathname)
  } else { return undefined }
  if not inside(boundary, file) { return undefined }
  let bytes = transport.file(file, boundary)
  if bytes == undefined { return undefined }
  let extension = file.slice(file.lastIndexOf(".") + 1).toLowerCase()
  return response(200, bytes, {"content-type": mimeTypes[extension] ?? "application/octet-stream"})
}
fn emit(state, level, message, fields) { try { if state.options.logger != undefined { state.options.logger[level](message, fields) } } catch _failure {} }
async fn send(state, socket, value, method, requestId, keep) {
  let status = 200; let headers = {}; let body = undefined; let type = undefined
