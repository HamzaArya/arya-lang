  let result = {handler: handler, schemas: Object.freeze(Object.assign({}, schemas))}
  runtime.tag(result, "web.route", true); return Object.freeze(result)
}
export async fn health(checks = {}, options = {}) {
  object(checks, "Health checks"); object(options, "Health options")
  let duration = timeout(options.timeoutMs ?? 1000, "Health timeoutMs")
  let operations = []
  for key in Object.keys(checks) {
    if runtime.kind(checks[key]) != "function" { throw new TypeError("Health checks must be functions.") }
    operations.push((async fn(name, check) {
      let controller = new AbortController(); let timer = undefined
      let deadline = new Promise(fn(resolve) { timer = setTimeout(fn() { controller.abort(); resolve("timeout") }, duration) })
      try {
        let work = Promise.resolve().then(fn() { return check(controller.signal) }).then(fn(value) { if value == false { return "failed" }; return "ok" }, fn() { return "failed" })
        return [name, await Promise.race([work, deadline])]
