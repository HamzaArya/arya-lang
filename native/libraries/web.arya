      let result = validate.check(value.schemas[name], input[name])
      if result.ok { input[name] = result.value }
      else { for issue in result.issues { issues.push(Object.assign({}, issue, {path: [name, ...issue.path]})) } }
    }
    if len(issues) > 0 { let failure = error(400, "Input validation failed.", "ARYA_VALIDATION"); failure.issues = issues.slice(0, 32); throw failure }
    return await value.handler(input)
  }
  if runtime.kind(value) == "function" { return await value(input) }
