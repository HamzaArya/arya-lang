    while not state.stopping {
      let request = undefined; let requestId = transport.requestId(); let method = "GET"; let pathname = "/"; let timer = undefined; let background = undefined; let controller = undefined; let started = performance.now(); let status = 500
      try {
        request = await transport.read(socket.handle, state.limit, state.requestTimeout)
