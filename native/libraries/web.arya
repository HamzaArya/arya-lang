}
fn findRoute(routes, patterns, method, pathname) {
  let candidates = [method]; if method == "HEAD" { candidates.push("GET") }
  for candidate in candidates {
    if Object.hasOwn(routes, candidate + " " + pathname) { return {value: routes[candidate + " " + pathname], params: {}} }
    if Object.hasOwn(routes, pathname) { return {value: routes[pathname], params: {}} }
    let segments = pathname.split("/")
    for pattern in patterns {
      if pattern.method != undefined and pattern.method != candidate or len(pattern.segments) != len(segments) { continue }
      let params = {}; let matches = true
      for expected at i in pattern.segments {
        let actual = segments[i]
        if expected.startsWith(":") {
