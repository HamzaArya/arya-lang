    "python": "An explicit Python import/call needs a separately installed Python interpreter. Core compilation/execution never launches it.",
    "mysql": "A separately installed MySQL C client SDK selected by ARYA_MYSQL_PREFIX; not bundled. Prepared statements, exact DECIMAL/BIGINT strings and bounded pools.",
    "desktop": "macOS AppKit/WebKit system frameworks, linked only by explicit desktop imports.",
    "editor": "The editor supplies its own extension host. The extension transports requests to the bundled native LSP; it is not a Node language compiler."
  },
  "limits": {
    "decimal": "4096 context digits; 1024-character canonical input/output; output scales 0–100; nine explicit rounding modes",
    "accounting": "1000000 rows, 100000 accounts, signed 64-bit per-line minor units, checked signed 128-bit products/aggregates, scales 0–6, two active cooperative asynchronous calculations",
    "strings": "16 Mi UTF-16 units",
    "buffers": "16 MiB",
    "asyncTasks": 512,
    "calls": 512,
    "modules": 1024,
    "source": "16 Mi UTF-16 units per project",
    "regex": "PCRE2 native semantics, no JIT, bounded execution; not a full ECMAScript engine",
    "csv": "65536 UTF-16 units per push; defaults: field 65536 units, record 1048576 units, 1024 columns; field/record configurable up to 1048576, columns up to 1024; readChunk 1–1048576 input bytes plus at most three carried UTF-8 bytes",
    "json": "16 Mi UTF-16 input units, 16 MiB UTF-8 output, 100000 value nodes and depth 128; JSON-lines io.readLine frames are 1 MiB",
    "money": "Explicit three-letter uppercase currency tag, scale 0–100 and explicit rounding; exact parsed amount with decimal bounds",
    "finance": "100000 rows/periods, two active cooperative prepared calculations, 4096-row cancellation chunks; decimal bounds for all intermediates"
  },
  "compatibility": {
    "retainedImplementation": "compat/node",
    "nodePackageImports": "use js / Node packages and JavaScript module emission remain in the retained 1.3 implementation; native code uses Arya modules or explicit foreign protocols.",
