use std "runtime" as runtime
const mode = args[0]
const count = number(args[1])
fn work(n) {
  let checksum = 0
  let i = 0
  while i < n {
    let value = i % 10000
    let text = ""
    if mode == "fixed" { text = (value + 0.25).toFixed(2) }
    else if mode == "radix" { text = value.toString(16) }
    else { text = value.toString() }
    checksum += text.length
    i += 1
  }
  return checksum
}
work(2000)
runtime.collect()
const start = runtime.clock()
const checksum = work(count)
print(checksum, (runtime.clock() - start) * 1000)
