use std "io" as io
use std "json" as json
use std "runtime" as runtime
use std "decimal" as decimal
fn sum(n: number): number { let result = 0; let i = 0; while i < n { result += i; i += 1 }; return result }
fn mix(n: number): number { let result = 1; let i = 0; while i < n { result = (result * 1.000001 + i % 97) % 1000003; i += 1 }; return result }
fn fib(n: number): number { if n < 2 { return n }; return fib(n - 1) + fib(n - 2) }
fn records(n) { let rows: any = []; for i in range(n) { rows.push({index: i, balance: i * 0.5, type: i % 2}) }; let result = 0; for row in rows { if row.type == 1 { result += row.balance } }; return [len(rows), result] }
fn maps(n) { let values = new Map(); for i in range(n) { values.set("key:" + str(i), i) }; let result = 0; for i in range(n) { result += values.get("key:" + str(i)) }; return result }
fn codec(n) { const value = {balance: "100.005", type: "asset", items: [1, 2, 3]}; let result = 0; for i in range(n) { const encoded: any = json.stringify(value); const decoded: any = json.parse(encoded); result += decoded.items[1] }; return result }
fn text(n) { let result = 0; for i in range(n) { result += len((" row " + str(i)).trim().toUpperCase().split(" ").join("-")) }; return result }
fn exact(n) { let result = "0"; for i in range(n) { result = decimal.add(result, "123456789012345678901234567890.005") }; return result }
# PARSED_KERNEL
fn work(kind, n) {
  if kind == "sum" { return sum(n) }; if kind == "mix" { return mix(n) }; if kind == "fib" { return fib(n) }
  if kind == "records" { return records(n) }; if kind == "map" { return maps(n) }; if kind == "json" { return codec(n) }
  if kind == "strings" { return text(n) }; return exact(n)
}
while true {
  const line = io.readLine(); if line == null { break }; const request: any = json.parse(line)
  const start = runtime.clock(); const result = work(request.kind, request.n); const elapsed = (runtime.clock() - start) * 1000
  print(json.stringify({value: result, cpuMs: elapsed}))
}
