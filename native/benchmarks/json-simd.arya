use std "runtime" as runtime
const mode = args[0]
const count = number(args[1])
let source = ""
let expected = 0
if mode == "ascii8192" {
  source = '"' + "a".repeat(8192) + '"'; expected = 8192
} else if mode == "unicode8192" {
  source = '"' + "سلام".repeat(2048) + '"'; expected = 8192
} else if mode == "escaped8192" {
  source = '"' + "a".repeat(8184) + '\\n' + "tail" + '"'; expected = 8189
} else if mode == "short" {
  source = '["USD","cash","42.00","paid"]'; expected = 4
} else if mode == "rows" or mode == "mixed" {
  const rows = []
  for i in range(100) {
    let row: any = {id: i, account: "cash", currency: "AFN", amount: "12.50"}
    if mode == "mixed" { row.description = "سلام 🌉 \"Arya\"\n"; row.note = ""; row.active = true }
    rows.push(row)
  }
  source = JSON.stringify(rows) ?? ""; expected = 100
} else { throw new Error("Unknown JSON SIMD benchmark mode.") }
fn work(iterations) {
  let sum = 0; let i = 0
  while i < iterations { sum += len(JSON.parse(source)); i += 1 }
  return sum
}
work(20)
runtime.collect()
const start = runtime.clock()
const sum = work(count)
const elapsed = (runtime.clock() - start) * 1000
if sum != count * expected { throw new Error("JSON SIMD benchmark checksum mismatch.") }
print(sum, elapsed)
