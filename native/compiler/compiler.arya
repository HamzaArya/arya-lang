fn validateProgram() {
  checkTypes()
  for unit in units {
    let analysis = tooling.inspect(unit.ast, fn(node) { if nativeGlobal(node) { return null }; return binding(node) }, fn(_node) { return null }, undefined, true)
    for error in analysis.diagnostics { if error.code != "ARYA_UNREACHABLE" { fail(error.token, error.message, error.code) } }
    for ref in analysis.references {
      if ref.access == "write" or ref.access == "readwrite" {
