    let analysis = tooling.inspect(unit.ast, fn(node) { if nativeGlobal(node) { return null }; return binding(node) }, fn(_node) { return null }, undefined, true)
    for value in analysis.bindings { value.mutableCaptured = value.typeWritten and value.typeCaptured }
  }
  for unit in units {
    if unit.filename.startsWith(standardDirectory + "/") { continue }
    checker.check(unit.ast, {lookup: binding, global: nativeGlobal, declared: bindingType, infer: inferred, fresh: freshValue, member: memberType, signature: functionType, outcomes: completions, fail: fail})
