  semanticChecking = true
  for unit in units {
    let analysis = tooling.inspect(unit.ast, fn(node) { if nativeGlobal(node) { return null }; return binding(node) }, fn(_node) { return null }, undefined, true)
    for ref in analysis.references { if ref.access != "read" and ref.access != "member" { ref.binding.typeWritten = true }; if scopeOwner(ref.node.scope) != scopeOwner(ref.binding.scope) { ref.binding.typeCaptured = true } }
