  if needsAuth { features += "#define ARYA_AUTH 1\n" }
  if runtimeCounters { features += "#define ARYA_RUNTIME_COUNTERS 1\n" }
  if debugBuild { features += "#define ARYA_NATIVE_DEBUG 1\n" }
  if needsURL { features += "#define ARYA_URL 1\n" }
  if needsHTTP { features += "#define ARYA_HTTP 1\n" }
  if needsMySQL { features += "#define ARYA_MYSQL 1\n" }
  if needsPython { features += "#define ARYA_PYTHON 1\n" }
  if needsRegex { features += "#define ARYA_REGEX 1\n" }
  if needsDesktop { features += "#define ARYA_DESKTOP 1\n" }
