fn resetAnalysis(root) {
  scopeCounter = 0; functionCounter = 0; definitions = []; prototypes = []; units = []; loaded = []; sourceBytes = 0
  projectRoot = root; projectBoundaries = []; standardBindings = {}; currentFile = ""; typeCheckEnabled = false; semanticChecking = false; inferenceDepth = 0; refinements = []; sourceOverlay = {}
  needsCrypto = false; needsAuth = false; needsURL = false; needsHTTP = false; needsMySQL = false; needsPython = false; needsRegex = false; needsDesktop = false; needsGUI = false; needsAccounting = false
  standardDirectory = path.join(path.dirname(process.executable()), "stdlib")
  analysisRecover = false
  callOptimization = true; advancedCallOptimization = true; runtimeCounters = false; debugBuild = false; nativeFunctions = []
  dataOptimization = true; stringLiterals = []; stringLiteralSlots = {}
}
fn memberBinding(node) {
  if node.key.kind != "literal" { return null }
  let value = null
  if node.object.kind == "name" and not nativeGlobal(node.object) { try { value = binding(node.object) } catch _failure { return null } }
  if value != null and value.kind == "import" and value.imported.bridge == "arya" and value.imported.unit != undefined { for item in value.imported.unit.ast.statements { if item.exported and item.binding.name == node.key.value { return item.binding } } }
  let base = inferred(node.object)
  if types.kind(base) != "record" or base.fields[node.key.value] == undefined { return null }
  let key = node.key.value; if value != null and value.kind == "import" { key = value.imported.specifier + "." + key } else { key = "property:" + str(node.token.filename) + ":" + str(node.token.start) }
  if standardBindings[key] != undefined { return standardBindings[key] }
  let type = base.fields[node.key.value].type; let symbol = {kind: "standard", name: node.key.value, inferredType: type}
  if types.kind(type) == "function" { symbol.functionValue = {signature: type} }
  standardBindings[key] = symbol; return symbol
}

fn analyzeSources(snapshots, root, boundaries) {
  resetAnalysis(root)
  projectBoundaries = boundaries ?? []
  analysisRecover = true
  for snapshot in snapshots { sourceOverlay[snapshot.filename] = snapshot.source }
  let errors = []
  for snapshot in snapshots { try { load(snapshot.filename, []) } catch error { errors.push({filename: error.file ?? snapshot.filename, error: error}) } }
  for unit in loaded { for error in unit.ast.diagnostics { errors.push({filename: unit.filename, error: error}) } }
  if len(errors) == 0 { try { validateProgram() } catch error { errors.push({filename: error.file ?? currentFile, error: error}) } }
  let documents = []
  for unit in loaded {
    if unit.filename.slice(0, len(standardDirectory) + 1) == standardDirectory + "/" { continue }
    let source = sourceOverlay[unit.filename]; if source == undefined { source = fs.readTextSync(unit.filename) }
    let analysis = tooling.inspect(unit.ast, fn(node) { if nativeGlobal(node) { return null }; return binding(node) }, inferred, memberBinding)
    let tokens = unit.ast.tokens
    documents.push({filename: unit.filename, source: source, ast: unit.ast, analysis: analysis, tokens: tokens})
  }
  return {documents: documents, errors: errors}
}
fn describeBinding(value) { return types.text(bindingType(value)) }
