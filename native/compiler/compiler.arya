let loaded = []
let sourceBytes = 0
fn load(filename, active) {
  if sourceOverlay[filename] == undefined { filename = path.realPath(filename) }
  let inProject = projectRoot == "/" or filename == projectRoot or filename.slice(0, len(projectRoot) + 1) == projectRoot + "/"
  if len(projectBoundaries) > 0 { inProject = false; for boundary in projectBoundaries { if filename == boundary or filename.startsWith(boundary + "/") or boundary == "/" { inProject = true } } }
  let inStandard = standardDirectory != "" and filename.slice(0, len(standardDirectory) + 1) == standardDirectory + "/"
  if not inProject and not inStandard { throw "Module escapes the project root: " + filename }
  if active.includes(filename) { throw "Arya module cycle: " + filename }
  for unit in loaded { if unit.filename == filename { return unit } }
  if len(loaded) >= 1024 { throw "Project exceeds 1024 modules." }
  if sourceOverlay[filename] == undefined and not fs.isFile(filename) { throw "Choose a regular Arya source file: " + filename }
  let source = sourceOverlay[filename]
  if source == undefined { source = fs.readTextSync(filename) }
  sourceBytes += len(source)
  if sourceBytes > 16777216 { throw "Project exceeds 16 MiB." }
  let unit = {filename: filename, source: source, ast: parseMode(source, filename, analysisRecover), id: len(loaded)}
  loaded.push(unit); active.push(filename)
  for s in unit.ast.statements {
    if s.kind == "import" and s.bridge == "std" and s.specifier == "security" { needsCrypto = true }
    if s.kind == "import" and s.bridge == "std" and has(["auth", "_auth"], s.specifier) { needsAuth = true; needsCrypto = true }
    if s.kind == "import" and s.bridge == "std" and s.specifier == "desktop" { needsDesktop = true }
    if s.kind == "import" and s.bridge == "std" and s.specifier == "gui" { needsGUI = true }
    if s.kind == "import" and s.bridge == "std" and s.specifier == "_accounting" { needsAccounting = true }
    if s.kind == "import" and s.bridge == "std" and s.specifier == "_http" { needsHTTP = true }
    if s.kind == "import" and s.bridge == "std" and s.specifier == "_mysql" { needsMySQL = true }
    if s.kind == "import" and (s.bridge == "python" or s.bridge == "std" and s.specifier == "_python") { needsPython = true }
    if s.kind == "import" and s.bridge == "std" and has(["testing", "web", "mysql", "python", "ui", "path", "accounting", "money", "finance", "csv", "auth"], s.specifier) { s.unit = load(path.join(standardDirectory, s.specifier + ".arya"), active) }
    if s.kind == "import" and s.bridge == "arya" { s.unit = load(path.resolve(path.dirname(filename), s.specifier), active) }
  }
  active.pop(); units.push(unit); return unit
}
