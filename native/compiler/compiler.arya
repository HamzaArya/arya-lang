  if types.kind(type) == "record" { return runtime.keys(type.fields) }
  if types.kind(type) == "array" { return ["length", "map", "filter", "flatMap", "find", "findLast", "findIndex", "findLastIndex", "forEach", "some", "every", "reduce", "reduceRight", "flat", "slice", "splice", "push", "pop", "shift", "unshift", "join", "sort", "reverse", "fill", "copyWithin", "toSorted", "toReversed", "toSpliced", "with", "concat", "includes", "indexOf", "lastIndexOf", "at", "entries", "keys", "values"] }
  if type == "string" { return ["length", "at", "charAt", "charCodeAt", "codePointAt", "includes", "indexOf", "lastIndexOf", "slice", "substring", "substr", "trim", "trimStart", "trimEnd", "split", "replace", "replaceAll", "startsWith", "endsWith", "toUpperCase", "toLowerCase", "match", "matchAll", "search", "padStart", "padEnd", "repeat", "isWellFormed", "toWellFormed"] }
  return []
}

fn main() {
  if args[0] == "editor" { editor.run(args); return }
  if args[0] == "create" or args[0] == "init" { project.create(args); return }
  if args[0] == "lsp" {
    if len(args) > 2 or len(args) == 2 and args[1] != "--stdio" { throw "Use arya lsp [--stdio]." }
    lsp.serve(VERSION, analyzeSources, describeBinding, fieldsFor, fn(source, filename) { parse(source, filename); return tooling.format(source, tokenize(source)) }, reserved)
    return
  }
  if len(args) == 1 and args[0] == "--version" { print("Arya native " + VERSION + " (self-hosted)"); return }
  if len(args) >= 2 and has(["fmt", "lint"], args[0]) {
    let filename = path.realPath(args[1]); let source = fs.readTextSync(filename); let ast = parse(source, filename)
    let analysis = tooling.inspect(ast, fn(node) { if nativeGlobal(node) { return null }; return binding(node) }, inferred)
    for diagnostic in analysis.diagnostics { if diagnostic.code == "ARYA_NAME" { fail(diagnostic.token, diagnostic.message, diagnostic.code) } }
    if args[0] == "fmt" {
      if len(args) > 3 or len(args) == 3 and args[2] != "--check" { throw "Use arya fmt file.arya [--check]." }
      let formatted = tooling.format(source, tokenize(source))
      if args[2] == "--check" { if source != formatted { process.error("Formatting required: " + filename); process.exit(1) } }
      else if formatted != source { fs.writeTextSync(filename, formatted) }
    } else {
      if len(args) > 2 { throw "Use arya lint file.arya." }
      for diagnostic in analysis.diagnostics { process.error(filename + ":" + str(diagnostic.token.line + 1) + ":" + str(diagnostic.token.column + 1) + ": " + diagnostic.code + ": " + diagnostic.message) }
      if analysis.diagnostics.length > 0 { process.exit(1) }
    }
    return
  }
  if len(args) < 2 or not has(["check", "build", "run", "test", "native"], args[0]) {
    print("Arya native " + VERSION + " — self-hosted C11 compiler")
    print("arya create [directory] [--template web|api|cli|ui|desktop|native-gui]")
    print("arya init [directory] --web")
    print("arya editor status|install|path [--editor all|code|aryacode|cursor|codium|windsurf]")
    print("arya check|build|run source.arya [-o executable] [-- program arguments]")
    print("arya test file.test.arya | arya fmt file.arya [--check] | arya lint file.arya | arya lsp --stdio")
    return
  }
  let command = args[0]
  if command == "test" { command = "run" }
  if command == "native" { command = "build" }
  standardDirectory = path.join(path.dirname(process.executable()), "stdlib")
  let filename = path.realPath(args[1])
  projectRoot = path.dirname(filename)
  let output = path.join(projectRoot, ".arya", "native", path.basename(filename).slice(0, -5))
  let compiler = process.env("ARYA_CC") or process.env("CC") or "cc"
  let libraryDirectory = process.env("ARYA_NATIVE_LIBDIR") or path.join(path.dirname(process.executable()), "lib")
  let programArgs = []
  let mode = "-O2"
  let force = false
  let sanitize = false
  let explicitOutput = false
  let i = 2
  while i < len(args) {
    let option = args[i]
    if option == "--" { programArgs = args.slice(i + 1); break }
    if option == "-o" or option == "--output" { i += 1; if i >= len(args) { throw "-o requires a path." } output = path.resolve(args[i]); explicitOutput = true }
    else if option == "--cc" { i += 1; if i >= len(args) { throw "--cc requires a compiler." } compiler = args[i] }
    else if option == "--force" { force = true }
    else if option == "--sanitize" { sanitize = true }
    else if option == "--no-call-opt" { callOptimization = false; advancedCallOptimization = false }
    else if option == "--no-advanced-call-opt" { advancedCallOptimization = false }
    else if option == "--runtime-counters" { runtimeCounters = true }
    else if option == "--no-data-opt" { dataOptimization = false }
    else if option == "--json" and command == "check" { }
    else if option == "--debug" { mode = "-O0" }
    else if option == "--release" { mode = "-O2" }
    else if option == "--target" { i += 1; if args[i] != "native" { throw "Self-hosted Arya supports --target native." } }
    else { throw "Unknown compiler option: " + option }
    i += 1
  }
  if command != "run" and len(programArgs) > 0 { throw "Program arguments require arya run." }
  let automaticRun = command == "run" and not explicitOutput
  let buildFlags = {calls: callOptimization, advancedCalls: advancedCallOptimization, data: dataOptimization, counters: runtimeCounters}
  if automaticRun {
    for suffix in ["", ".c", ".NOTICE", ".BUILD"] { let info = fs.infoSync(output + suffix); if info != null and info.type != "file" { throw "Native run output must be a regular file: " + output + suffix } }
    if not force and build_cache.reusable(output, filename, compiler, libraryDirectory, mode, sanitize, buildFlags) { let runArgs = [output]; for argument in programArgs { runArgs.push(argument) }; process.exit(process.run(runArgs)) }
  }
  if command == "check" { analysisRecover = true }
  load(filename, [])
  let syntaxErrors = []; for unit in loaded { for error in unit.ast.diagnostics { syntaxErrors.push(error) } }
  if len(syntaxErrors) > 0 { let first = syntaxErrors[0]; first.diagnostics = syntaxErrors; throw first }
  debugBuild = mode == "-O0"
  if command == "check" { validateProgram(); if args.includes("--json") { print(runtime.jsonStringify({ok: true, command: "check", file: filename, target: "native", diagnostics: []})) } else { print("Check OK (native): " + filename) }; return }
  for unit in loaded { if output == unit.filename { throw "Output cannot replace source." } }
  let code = generate()
  let cacheConfiguration = null
  if automaticRun {
    cacheConfiguration = build_cache.configuration(compiler, libraryDirectory, mode, sanitize, needsMySQL, buildFlags)
    force = true
  }
  if not force and (fs.existsSync(output) or fs.existsSync(output + ".c") or fs.existsSync(output + ".NOTICE")) { throw "Native output already exists; choose another path or explicitly use --force." }
  let invocation = [compiler, "-std=c11", mode, "-ffp-contract=off", "-I", libraryDirectory, "SOURCE", "-o", "OUTPUT", path.join(libraryDirectory, "libmpdec.a"), "-lm", "-pthread"]
  if needsCrypto { if not fs.existsSync(path.join(libraryDirectory, "libcrypto.a")) { throw "Native crypto SDK missing; build make native-crypto." }; invocation.push("-I"); invocation.push(path.join(libraryDirectory, "include")); invocation.push(path.join(libraryDirectory, "libcrypto.a")); invocation.push("-pthread"); if runtime.platform() == "linux" { invocation.push("-ldl") } }
  if needsAuth and runtime.platform() == "darwin" {
    if not fs.existsSync(path.join(libraryDirectory, "libarya-auth.a")) { throw "Native authentication SDK missing; build make native-auth." }
    invocation.push(path.join(libraryDirectory, "libarya-auth.a")); for framework in ["Foundation", "LocalAuthentication", "Security"] { invocation.push("-framework"); invocation.push(framework) }
  }
  if needsURL { if not fs.existsSync(path.join(libraryDirectory, "libada.a")) { throw "Native URL SDK missing; build make native-url." }; invocation.push("-I"); invocation.push(path.join(libraryDirectory, "include")); invocation.push(path.join(libraryDirectory, "libada.a")); if runtime.platform() == "darwin" { invocation.push("-lc++") } else { invocation.push("-lstdc++") } }
  if needsHTTP { if not fs.existsSync(path.join(libraryDirectory, "libllhttp.a")) { throw "Native HTTP SDK missing; build make native-http." }; invocation.push("-I"); invocation.push(path.join(libraryDirectory, "include")); invocation.push(path.join(libraryDirectory, "libllhttp.a")) }
  if needsRegex { if not fs.existsSync(path.join(libraryDirectory, "libpcre2-16.a")) { throw "Native regex SDK missing; build make native-regex." }; invocation.push("-I"); invocation.push(path.join(libraryDirectory, "include")); invocation.push(path.join(libraryDirectory, "libpcre2-16.a")) }
  if needsGUI {
    if not fs.existsSync(path.join(libraryDirectory, "libarya-gui.a")) or not fs.existsSync(path.join(libraryDirectory, "gui-link-flags")) { throw "Native GUI SDK missing; build make native-gui (GTK 3 development files required on Linux)." }
    invocation.push(path.join(libraryDirectory, "libarya-gui.a"))
    for flag in fs.readTextSync(path.join(libraryDirectory, "gui-link-flags")).split("\n") { if flag != "" { invocation.push(flag) } }
  }
  if needsDesktop {
    if runtime.platform() != "darwin" { throw "Native desktop currently requires macOS AppKit/WebKit." }
    if not fs.existsSync(path.join(libraryDirectory, "libarya-desktop.a")) { throw "Native desktop SDK missing; build make native-desktop." }
    invocation.push(path.join(libraryDirectory, "libarya-desktop.a")); invocation.push("-framework"); invocation.push("Cocoa"); invocation.push("-framework"); invocation.push("WebKit")
  }
  if needsMySQL {
    let prefix = process.env("ARYA_MYSQL_PREFIX") or "/usr/local/mysql"
    if not fs.isFile(path.join(prefix, "include", "mysql.h")) { throw "Native MySQL C SDK missing; set ARYA_MYSQL_PREFIX to its installation directory." }
    invocation.push("-I"); invocation.push(path.join(prefix, "include")); invocation.push("-L" + path.join(prefix, "lib")); invocation.push("-Wl,-rpath," + path.join(prefix, "lib")); invocation.push("-lmysqlclient"); invocation.push("-pthread")
  }
  if sanitize { invocation.push("-fsanitize=address,undefined"); invocation.push("-fno-omit-frame-pointer") }
  fs.makeDirectory(path.dirname(output))
  let stage = fs.tempDirectory(output + ".arya-XXXXXX")
  try {
  let cfile = path.join(stage, "program.c")
  let staged = path.join(stage, "program")
  let notices = path.join(stage, "NOTICE")
  fs.writeTextSync(cfile, code)
  fs.writeTextSync(notices, runtime_source.notices)
  invocation[6] = cfile; invocation[8] = staged
  let status = process.run(invocation)
  if status != 0 { if fs.existsSync(staged) { fs.remove(staged) }; fs.remove(cfile); fs.remove(notices); project.removeStage(stage); process.exit(status) }
  if force { fs.rename(cfile, output + ".c"); fs.rename(notices, output + ".NOTICE"); fs.rename(staged, output) }
  else {
    try { fs.publish(notices, output + ".NOTICE") }
    catch error { fs.remove(staged); fs.remove(cfile); fs.remove(notices); project.removeStage(stage); throw error }
    try { fs.publish(cfile, output + ".c") }
    catch error { fs.remove(output + ".NOTICE"); fs.remove(staged); fs.remove(cfile); fs.remove(notices); project.removeStage(stage); throw error }
    try { fs.publish(staged, output) }
    catch error { fs.remove(output + ".c"); fs.remove(output + ".NOTICE"); fs.remove(staged); fs.remove(cfile); fs.remove(notices); project.removeStage(stage); throw error }
    fs.remove(staged); fs.remove(cfile); fs.remove(notices)
  }
  if automaticRun { fs.writeTextSync(path.join(stage, "BUILD"), build_cache.save(output, filename, cacheConfiguration, loaded)); fs.rename(path.join(stage, "BUILD"), output + ".BUILD") }
  } catch error { if fs.infoSync(stage) != null { project.removeStage(stage) }; throw error }
  if fs.infoSync(stage) != null { project.removeStage(stage) }
  if command == "build" { print(output); return }
  let runArgs = [output]
  for argument in programArgs { runArgs.push(argument) }
  process.exit(process.run(runArgs))
}
try { main() }
catch error {
  if args[0] == "check" and args.includes("--json") {
    let values = error.diagnostics ?? [error]; let diagnostics = []
    for value in values { diagnostics.push({file: value.file ?? args[1], code: value.code ?? "ARYA_CLI", message: value.message ?? str(value), line: value.line, column: value.column, start: value.start, end: value.end, fixes: []}) }
    print(runtime.jsonStringify({ok: false, command: "check", file: args[1], target: "native", diagnostics: diagnostics})); process.exit(1)
  }
  if error.message != undefined { let message = "Compile error: " + error.message; if error.file != undefined { message += " at " + str(error.file) + ":" + str(error.line) + ":" + str(error.column) }; process.error(message) }
  else { process.error("Compile error: " + str(error)) }
  process.exit(1)
}
