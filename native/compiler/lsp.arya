        let folders = params.workspaceFolders; if folders == null or folders == undefined { folders = []; if params.rootUri != undefined and params.rootUri != null { folders.push({uri: params.rootUri}) } }
        for folder in folders { let filename = filePath(folder.uri); if filename != null and not roots.includes(filename) { roots.push(filename) } }
        response(message.id, {serverInfo: {name: "Arya Native Language Server", version: version}, capabilities: {positionEncoding: "utf-16", workspace: {workspaceFolders: {supported: true, changeNotifications: true}}, textDocumentSync: 2, completionProvider: {triggerCharacters: ["."]}, hoverProvider: true, documentSymbolProvider: true, definitionProvider: true, referencesProvider: true, renameProvider: {prepareProvider: true}, signatureHelpProvider: {triggerCharacters: ["(", ","]}, documentFormattingProvider: true, codeActionProvider: {codeActionKinds: ["quickfix"]}, semanticTokensProvider: {legend: {tokenTypes: ["namespace", "function", "variable", "parameter", "property", "method", "class"], tokenModifiers: ["declaration", "readonly", "defaultLibrary", "modification"]}, full: true}}}); continue
      }
      if method == "exit" { if not stopped { runtime.exitCode(1) }; return }
      if not initialized { if hasId { failure(message.id, -32002, "Initialize the language server first.") }; continue }
      if method == "shutdown" { stopped = true; response(message.id, null); continue }
      if stopped { if hasId { failure(message.id, -32600, "Language server has shut down.") }; continue }
      if method == "initialized" or method == "$/cancelRequest" { continue }
      if method == "textDocument/didOpen" {
        let value = params.textDocument; let filename = filePath(value.uri)
        if filename == null and value.uri.startsWith("untitled:") { filename = path.join(roots[0] ?? process.cwd(), ".arya-unsaved-" + runtime.uriEncode(value.uri) + ".arya") }
        if filename == null { continue }; if len(runtime.keys(open)) >= 128 and open[value.uri] == undefined { throw "Native language-server open-document limit is 128." }; if len(value.text) > 4194304 { throw "Source exceeds 4 Mi UTF-16 units." }; openingSize(value.uri, value.text)
        open[value.uri] = {filename: filename, source: value.text, version: value.version}; invalidate(); diagnostics(); continue
      }
      if method == "textDocument/didChange" {
        let value = document(params.textDocument.uri); if value == undefined or params.textDocument.version <= value.version { continue }; let source = value.source
        for change in params.contentChanges { if change.range == undefined { source = change.text } else { let start = offset(source, change.range.start); let end = offset(source, change.range.end); if end < start { throw "Invalid document change range." }; source = source.slice(0, start) + change.text + source.slice(end) } }
        if len(source) > 4194304 { throw "Source exceeds 4 Mi UTF-16 units." }; openingSize(params.textDocument.uri, source); value.source = source; value.version = params.textDocument.version; invalidate(); diagnostics(); continue
      }
      if method == "textDocument/didClose" { let value = document(params.textDocument.uri); if value != undefined { let next = {}; for uri in runtime.keys(open) { if uri != params.textDocument.uri { next[uri] = open[uri] } }; open = next; invalidate(); send({jsonrpc: "2.0", method: "textDocument/publishDiagnostics", params: {uri: params.textDocument.uri, diagnostics: []}}); diagnostics() }; continue }
      if method == "workspace/didChangeWorkspaceFolders" { for removed in params.event.removed { let filename = filePath(removed.uri); roots = roots.filter(fn(root) { return root != filename }) }; for added in params.event.added { let filename = filePath(added.uri); if filename != null and not roots.includes(filename) { roots.push(filename) } }; invalidate(); diagnostics(); continue }
      if method == "workspace/didChangeWatchedFiles" or method == "workspace/didChangeConfiguration" or method == "textDocument/didSave" { invalidate(); diagnostics(); continue }
