# Native project creation. Templates compile directly to ordinary executables.
use std "fs" as fs
use std "path" as path
use std "process" as process
use std "runtime" as runtime

fn commonMain(template) {
  if template == "cli" { return """use std "decimal" as decimal
use std "io" as io
let amount = args[0] ?? "19.95"
let quantity = args[1] ?? "3"
io.print("Total: " + decimal.quantize(decimal.multiply(decimal.from(amount), decimal.from(quantity)), 2, "half-even"))
""" }
  if template == "api" { return """use std "web" as web
use std "env" as env
use std "decimal" as decimal
use std "validate" as validate
let server = web.serve(env.int("PORT", 3000), {
  "GET /health": fn() { return web.health() },
  "POST /api/total": web.route(fn(request) {
    return {total: decimal.quantize(decimal.multiply(decimal.from(request.body.price), decimal.from(request.body.quantity)), 2, "half-even")}
  }, {body: validate.object({price: validate.string(), quantity: validate.string()})})
}, {host: "127.0.0.1", html: false, assets: false})
print("Arya API: http://127.0.0.1:" + str(server.address().port))
""" }
  if template == "web" { return """use std "web" as web
use std "env" as env
let server = web.serve(env.int("PORT", 3000), {
  "GET /api/hello": fn() { return {message: "Hello from native Arya"} }
}, {host: "127.0.0.1"})
print("Arya web: http://127.0.0.1:" + str(server.address().port))
""" }
  let result = """use std "web" as web
use std "ui" as ui
use std "decimal" as decimal
use std "validate" as validate
use std "env" as env
fn page() {
  return ui.page({title: "Arya Studio", state: {price: "19.95", quantity: "3", result: null, busy: false, problem: ""}, body: ui.stack([
    ui.text("MADE WITH ARYA", {class: "arya-eyebrow"}),
    ui.heading("Make something useful."),
    ui.text("A native application with precise decimal calculations.", {class: "arya-muted"}),
    ui.grid([
      ui.card([
        ui.heading("Order total", {level: 2}),
        ui.form([
          ui.label("Unit price", "price"), ui.input({id: "price", bind: "price", required: true, inputmode: "decimal"}),
          ui.label("Quantity", "quantity"), ui.input({id: "quantity", bind: "quantity", required: true, inputmode: "numeric"}),
          ui.button("Calculate total", {type: "submit", disabled: ui.bind("busy", false)})
        ], {action: ui.request("/api/total", {method: "POST", body: {price: ui.bind("price"), quantity: ui.bind("quantity")}, result: "result", pending: "busy", error: "problem"})})
      ]),
      ui.card([
        ui.heading("Your total", {level: 2}),
        ui.text(ui.bind("result.message", "Enter a price and quantity."), {role: "status", "aria-live": "polite"}),
        ui.text(ui.bind("problem"), {role: "alert"})
      ])
    ])
  ])})
}
let server = web.serve(env.int("PORT", 3000), {
  "GET /": fn() { return web.response(200, page(), {"cache-control": "no-store"}) },
  "POST /api/total": web.route(fn(request) {
    let total = decimal.quantize(decimal.multiply(decimal.from(request.body.price), decimal.from(request.body.quantity)), 2, "half-even")
    return {total: total, message: "Order total: " + total}
  }, {body: validate.object({price: validate.string(), quantity: validate.string()})})
}, {host: "127.0.0.1", html: false, assets: false})
"""
  if template == "desktop" { result = "use std \"desktop\" as desktop\n" + result.replaceAll("env.int(\"PORT\", 3000)", "0") + "let window = desktop.open(\"http://127.0.0.1:\" + str(server.address().port), {title: \"Arya Studio\"})\nawait window.closed\nawait web.shutdown(server)\n" }
  else { result += "print(\"Arya UI: http://127.0.0.1:\" + str(server.address().port))\n" }
  return result
}
fn templateFiles(template) {
  let main = commonMain(template)
  if template != "cli" {
    let cleanup = "for signal in [\"SIGINT\", \"SIGTERM\"] { process.onSignal(signal, async fn() { await web.shutdown(server) }, {once: true}) }\n"
    if template == "desktop" { cleanup = "for signal in [\"SIGINT\", \"SIGTERM\"] { process.onSignal(signal, async fn() { window.close(); await web.shutdown(server) }, {once: true}) }\n"; main = main.replaceAll("await window.closed\n", cleanup + "await window.closed\n") }
    else { main += cleanup }
    main = "use std \"process\" as process\n" + main
  }
  let files = {"main.arya": main, ".gitignore": ".arya/\n.env\n.DS_Store\n", "main.test.arya": "use std \"testing\" as testing\nuse std \"decimal\" as decimal\ntesting.test(\"decimal totals preserve cents\", fn() { testing.equal(decimal.multiply(\"19.95\", \"3\"), \"59.85\") })\n"}
  files["arya.json"] = runtime.jsonStringify({name: "arya-app", entry: "main.arya", target: "native", template: template}, null, 2) + "\n"
  files["Makefile"] = "ARYA ?= arya\n.PHONY: run build check test fmt\nrun:\n\t$(ARYA) run main.arya\nbuild:\n\t$(ARYA) build main.arya -o .arya/app --release --force\ncheck:\n\t$(ARYA) check main.arya\ntest:\n\t$(ARYA) test main.test.arya\nfmt:\n\t$(ARYA) fmt main.arya\n"
  files["README.md"] = "# Arya application\n\nRun `arya run main.arya`, build with `make build`, and run tests with `make test`.\nA C11 toolchain and the native Arya SDK are required to build; the compiled app runs directly.\n\n" + "This project uses the `" + template + "` template. Monetary inputs are decimal strings; calculations use `std decimal`.\n"
  if template == "desktop" { files["README.md"] += "\nThe desktop window uses the optional macOS AppKit/WebKit SDK. From the Arya source, build it with `make native-desktop`. Web content calls the local native HTTP application. Closing the window drains the server.\n" }
  if template == "web" {
    files["index.html"] = "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>Arya application</title><link rel=\"stylesheet\" href=\"/style.css\"></head><body><main id=\"root\"><p>MADE WITH ARYA</p><h1>Make something useful.</h1><p id=\"message\">A native Arya server, ready for your ideas.</p><button id=\"hello\">Say hello</button></main><script src=\"/app.js\" defer></script></body></html>\n"
    files["public/style.css"] = "html{font-family:system-ui;background:#10231e;color:#f2f3ea}body{margin:0}main{max-width:48rem;margin:15vh auto;padding:2rem}h1{font-size:clamp(2.5rem,6vw,5rem);letter-spacing:-.06em}button{font:inherit;padding:.8rem 1.2rem;border:0;border-radius:.5rem;background:#c9ec86;color:#10231e;cursor:pointer}\n"
    files["public/app.js"] = "document.querySelector('#hello').addEventListener('click',async()=>{try{const response=await fetch('/api/hello');const value=await response.json();document.querySelector('#message').textContent=value.message}catch{document.querySelector('#message').textContent='Could not reach the server.'}});\n"
  }
  files[".vscode/settings.json"] = "{}\n"
  return files
}
export fn removeStage(directory) {
  for name in fs.listSync(directory) { let file = path.join(directory, name); let info = fs.infoSync(file); if info.type == "directory" { removeStage(file) } else { fs.remove(file) } }
  fs.removeDirectory(directory)
}
export fn create(options) {
  let template = "web"; let directory = undefined; let index = 1
  while index < len(options) {
    let value = options[index]
    if value == "--template" { index += 1; template = options[index] }
    else if value == "--web" { template = "web" }
    else if value.startsWith("-") { throw "Unknown project option: " + value }
    else if directory == undefined { directory = value }
    else { throw "Choose one project directory." }
    index += 1
  }
  if not ["web", "api", "cli", "ui", "desktop"].includes(template) { throw "Choose --template web, api, cli, ui, or desktop." }
  if directory == undefined { if options[0] == "init" { directory = "." } else { directory = "arya-app" } }
  let destination = path.resolve(directory); let existing = fs.infoSync(destination)
  if existing != null and (existing.type != "directory" or len(fs.listSync(destination)) != 0) { throw "Choose a new or empty project directory: " + destination }
  let parent = path.dirname(destination); if fs.infoSync(parent) == null { fs.makeDirectory(parent) }
  let stage = fs.tempDirectory(path.join(parent, ".arya-create-XXXXXX"))
  try {
    let files = templateFiles(template)
    for name in runtime.keys(files) { let file = path.join(stage, name); fs.makeDirectory(path.dirname(file)); fs.writeTextSync(file, files[name]) }
    if existing == null { fs.publishDirectory(stage, destination) }
    else { fs.rename(stage, destination) }
  } catch error { try { removeStage(stage) } catch _cleanupFailure {}; throw error }
  print("Created native Arya " + template + " project: " + destination)
  print("cd '" + destination.replaceAll("'", "'\\''") + "'\narya run main.arya")
}
