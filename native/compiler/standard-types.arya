    return record({response: fnType(["number", "any", "any"], response, 2), error: fnType(["number", "string", "string"], "any", 2), route: fnType([fnType(["any"], "any"), "any"], "any", 1), health: fnType(["any", inputRecord({timeoutMs: "number"})], promise(response), 0), shutdown: fnType(["any", inputRecord({timeoutMs: "number", cleanup: fnType([], "any")})], promise("void"), 1), serve: fnType(["number", "any", inputRecord({host: "string", root: "string", html: either(["boolean", "string"]), assets: either(["boolean", "string"]), maxBodyBytes: "number", maxConnections: "number", requestTimeoutMs: "number", handlerTimeoutMs: "number", trustRequestId: "boolean", before: fnType(["any"], "any"), logger: "any"})], "any", 1)})
  }
  return "any"
}
