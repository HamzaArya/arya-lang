use python "math" as math
use python "./python-worker.py" as worker
use std "python" as python
use std "async" as task
use std "debug" as debug
use std "runtime" as runtime
use std "path" as path
debug.assert(math.sqrt(81) == 9)
debug.assert(worker.add.with([2], {right: 5}) == 7)
debug.assert(runtime.deepEqual(worker.summarize.with([[1, 2, 3]], {factor: 3}), {value: 18, nested: [true, null, "سلام 🌉"]}))
let client = python.client({interpreter: args[0], timeoutMs: 3000, maxConcurrency: 2, queueLimit: 10})
debug.assert(await client.call(math.sqrt, [64]) == 8)
debug.assert(await client.call(worker.asynchronous, [4]) == 8)
debug.assert(runtime.deepEqual(await client.map(worker.add, [1, 2, 3], {kwargs: {right: 4}}), [5, 6, 7]))
let bound = client.bind(worker, {kwargs: {right: 10}})
debug.assert(await bound.add(2) == 12)
debug.assert(await bound.add.with([2], {right: 7}) == 9)
debug.assert((await client.info()).executable.length > 0)
let failed = false
try { await client.map(worker.broken, [1, -1, 3]) } catch error { failed = error.code == "ARYA_PYTHON_EXCEPTION" and error.index == 1 and error.pythonType == "ValueError" and error.pythonTraceback.includes("python-worker.py") }
debug.assert(failed, "Python exception metadata")
failed = false
try { await client.call(worker.nonfinite) } catch error { failed = error.code == "ARYA_PYTHON_RETURN" }; debug.assert(failed)
failed = false
try { await client.call(worker.excessive, [], {maxOutputBytes: 1024}) } catch error { failed = error.code == "ARYA_PYTHON_OUTPUT_LIMIT" }; debug.assert(failed)
failed = false
try { await client.call(worker.delayed, [1, 2], {timeoutMs: 20}) } catch error { failed = error.code == "ARYA_PYTHON_TIMEOUT" }; debug.assert(failed)
failed = false
try { await client.call(worker.add, [1], {interpreter: "/arya-native-missing-python"}) } catch error { failed = error.code == "ARYA_PYTHON_NOT_FOUND" }; debug.assert(failed)
let serial = python.client({interpreter: args[0], maxConcurrency: 1, queueLimit: 2})
let running = serial.call(worker.delayed, [1, 0.2])
let controller = new AbortController()
let queued = serial.call(worker.delayed, [2], {signal: controller.signal})
controller.abort()
failed = false
try { await queued } catch error { failed = error.code == "ARYA_PYTHON_CANCELLED" }; debug.assert(failed)
debug.assert(serial.stats().queued == 0)
debug.assert(await running == 1)
let active = serial.call(worker.delayed, [3, 2], {signal: new AbortController().signal})
let cancellation = new AbortController()
let cancelled = client.call(worker.delayed, [1, 2], {signal: cancellation.signal})
setTimeout(fn() { cancellation.abort() }, 20)
failed = false
try { await cancelled } catch error { failed = error.code == "ARYA_PYTHON_CANCELLED" }; debug.assert(failed)
let drain = serial.close(); debug.assert(await active == 3); await drain
await client.close()
failed = false; try { await client.call(worker.add, [1]) } catch error { failed = error.code == "ARYA_PYTHON_CLOSED" }; debug.assert(failed)
print("native Python: sync/async calls, Unicode, keywords, bounded queues, exceptions, deadlines, cancellation and close passed")
