  testing.equal(math.and32(row[0], row[1]), row[3])
  testing.equal(math.or32(row[0], row[1]), row[4])
  testing.equal(math.xor32(row[0], row[1]), row[5])
  testing.equal(math.not32(row[0]), row[6])
  testing.equal(math.shiftLeft32(row[0], row[2]), row[7])
  testing.equal(math.shiftRight32(row[0], row[2]), row[8])
}
for invalid in [-1, 4294967296, 0.5, NaN, Infinity] {
  testing.throws(fn() { math.and32(invalid, 0) })
  testing.throws(fn() { math.or32(0, invalid) })
  testing.throws(fn() { math.xor32(invalid, 0) })
  testing.throws(fn() { math.not32(invalid) })
  testing.throws(fn() { math.shiftLeft32(invalid, 1) })
}
for invalid in [-1, 32, 0.5, NaN, Infinity] {
  testing.throws(fn() { math.shiftLeft32(1, invalid) })
  testing.throws(fn() { math.shiftRight32(1, invalid) })
}
testing.throws(fn() { math.and32("1", 1) })
testing.throws(fn() { math.not32() })
testing.throws(fn() { math.xor32(1) })
print("UInt32: 798 independent bit-operation vectors and invalid arguments passed")
