use std "auth" as auth
use std "debug" as debug
const legacy = "arya$scrypt$v1$16384$8$1$AAECAwQFBgcICQoLDA0ODw$-UcR7RnegX8rtewN6TGWEZa867uDMOMk_cEDdQ5p72w"
debug.assert(await auth.verifyPassword("migration example", legacy))
debug.assert(not await auth.verifyPassword("wrong", legacy))
debug.assert(auth.passwordNeedsUpgrade(legacy))
const result = await auth.verifyPasswordAndUpgrade("migration example", legacy)
debug.assert(result.ok and result.upgraded and not auth.passwordNeedsUpgrade(result.hash))
debug.assert(await auth.verifyPassword("migration example", result.hash))
const hashed = await auth.hashPassword("Arya سلام 🔐\0secret")
debug.assert(await auth.verifyPassword("Arya سلام 🔐\0secret", hashed))
debug.assert(not await auth.verifyPassword("Arya سلام 🔐", hashed))
const bad = await auth.verifyPasswordAndUpgrade("wrong", hashed)
debug.assert(not bad.ok and not bad.upgraded and bad.hash == null)
print("auth passwords: native scrypt, Unicode, migration and failed login passed")
