use std "gui" as gui
use std "runtime" as runtime
const typed: boolean = true
fn expect(value, message) { if not value { throw message } }
fn callWithoutArguments(action) { return action() }
fn rejects(action) { let failed = false; try { action() } catch _error { failed = true }; expect(failed, "Expected GUI validation error") }
const window = gui.window({title: "Arya native widget acceptance", width: 760, height: 600})
window.add({id: "label", type: "label", text: "Native 😀", x: 20, y: 20, width: 300, height: 24})
window.add({id: "button", type: "button", text: "Action", x: 20, y: 55, width: 120, height: 32})
window.add({id: "input", type: "input", text: "hello", x: 20, y: 100, width: 300, height: 30})
window.add({id: "notes", type: "textarea", text: "first\nsecond", x: 20, y: 145, width: 300, height: 110})
window.add({id: "done", type: "checkbox", text: "Complete", checked: true, x: 20, y: 270, width: 200, height: 30})
window.add({id: "choice", type: "select", items: ["same", "same", "other"], index: 1, x: 350, y: 20, width: 300, height: 32})
window.add({id: "rows", type: "list", items: ["alpha", "beta", "beta"], index: 2, x: 350, y: 70, width: 300, height: 200})
window.add({id: "progress", type: "progress", value: 0.375, x: 20, y: 320, width: 630, height: 24})
expect(window.get("label").text == "Native 😀", "Unicode label")
expect(window.get("input").text == "hello", "Native input")
expect(window.get("notes").text.replace("\r", "") == "first\nsecond", "Native multiline")
expect(window.get("done").checked, "Native checkbox")
expect(window.get("choice").index == 1 and window.get("choice").text == "same", "Duplicate choices preserve index")
expect(window.get("rows").index == 2 and window.get("rows").text == "beta", "Duplicate list rows preserve index")
expect(window.get("progress").value == 0.375, "Native progress")
window.set("input", {text: "edited 😀", enabled: false})
window.set("notes", {text: "revised\nnotes"})
window.set("done", {checked: false})
window.set("choice", {items: ["new", "new"], index: 1})
window.set("rows", {items: ["only"], index: 0})
window.set("progress", {value: 1})
expect(window.get("input").text == "edited 😀", "Updated input")
expect(not window.get("done").checked, "Updated checkbox")
expect(window.get("choice").index == 1, "Updated duplicate choices")
expect(window.get("rows").text == "only", "Updated list")
expect(window.get("progress").value == 1, "Updated progress")
rejects(fn() { window.add({id: "input", type: "input", x: 1, y: 1, width: 30, height: 30}) })
rejects(fn() { window.set("input", {text: "must not change", width: -1}) })
expect(window.get("input").text == "edited 😀", "Invalid mixed mutation is atomic")
rejects(fn() { window.set("choice", {items: ["replacement"], index: 2}) })
expect(window.get("choice").text == "new" and window.get("choice").index == 1, "Rejected selection preserves items")
rejects(fn() { window.set("input", {checked: true}) })
rejects(fn() { window.set("progress", {value: 1.01}) })
rejects(fn() { window.get("missing") })
rejects(fn() { callWithoutArguments(window.get) })
rejects(fn() { window.set("input", runtime.jsonParse('{"surprise":true}')) })
rejects(fn() { window.add({id: "bad id", type: "label", x: 1, y: 1, width: 20, height: 20}) })
window.set("choice", {items: []})
expect(window.get("choice").index == -1 and window.get("choice").text == "", "Empty choices clear selection")
window.set("rows", {index: -1})
expect(window.get("rows").index == -1, "Explicit empty list selection")
# A programmatic close produces the real backend lifecycle event exactly once.
window.close()
let closed = 0
while true { const event = await window.nextEvent(); if event == null { break }; if event.type == "close" { closed += 1 } }
expect(closed == 1, "Exactly one native close event")
window.close()
expect(await window.nextEvent() == null, "Closed nextEvent returns null")
rejects(fn() { window.get("input") })
rejects(fn() { window.set("input", {text: "closed"}) })
const second = gui.window({title: "Arya second native window", width: 300, height: 200})
second.close()
while await second.nextEvent() != null { }
print("native gui: all eight widgets, Unicode, duplicate labels, mutations, validation and lifecycle PASS (" + gui.platform() + ")")
