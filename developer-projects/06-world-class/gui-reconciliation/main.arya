use std "runtime" as runtime
use std "fs" as fs
use std "process" as process
fn text(value, label, limit = 120) {
  if runtime.kind(value) != "string" or value.trim().length == 0 or value.length > limit { throw new Error(label + " must be non-empty text (max " + str(limit) + ").") }
  return value.trim()
}
fn record(value) { if not runtime.isRecord(value) { throw new Error("Expected a JSON object.") }; return value }
fn rows(value, limit = 1000) { if not Array.isArray(value) or value.length > limit { throw new Error("Expected an array of at most " + str(limit) + " rows.") }; return value }
fn readJSON(file) { let info = fs.infoSync(file); if info == null or info.size > 1048576 { throw new Error("Input file missing or exceeds 1 MiB.") }; return JSON.parse(fs.readTextSync(file)) }
use std "decimal" as decimal
fn storedAmount(value) {
  if runtime.kind(value) != "string" or not new RegExp("^-?[0-9]{1,24}\\.[0-9]{2}$").test(value) { throw new Error("Invalid stored decimal total.") }
  return value
}
fn amount(value) {
  if runtime.kind(value) != "string" or not new RegExp("^-?[0-9]{1,18}(\\.[0-9]{1,2})?$").test(value) { throw new Error("Amount must be a decimal string with up to 18 integer and 2 fractional digits.") }
  return decimal.quantize(value, 2, "half-even")
}
use std "web" as web
use std "env" as env
const dataFile = env.get("DATA_FILE", "data.json")
fn save(next) {
  let encoded = JSON.stringify(next, null, 2)
  if Buffer.byteLength(encoded,"utf8") > 1048576 { throw web.error(409,"Stored data would exceed 1 MiB. Archive data before adding more.") }
  try { fs.writeTextAtomicSync(dataFile, encoded) }
  catch failure { throw web.error(503,"Could not persist the change. Existing data is unchanged.") }
}
fn safe(handler) { return fn(request) { try { return handler(request) } catch failure { if failure.aryaHttpStatus != undefined { throw failure }; throw web.error(400, failure.message ?? str(failure)) } } }
use std "ui" as ui
let state = {runs: []}
const storedInfo = fs.infoSync(dataFile)
if storedInfo != null and storedInfo.type != "file" { throw new Error("Data store must be a regular file; symlinks are not allowed.") }
if storedInfo != null {
  state = record(readJSON(dataFile)); rows(state.runs,100)
  for run in state.runs {
    record(run); text(run.label,"Stored run label",100); rows(run.differences,1000); for difference in run.differences { text(difference,"Stored exception",240) }
    if not Number.isInteger(run.matched) or run.matched < 0 or run.matched > 500 or runtime.kind(run.balanced) != "boolean" or run.balanced != (run.differences.length == 0) or storedAmount(run.difference) != decimal.quantize(decimal.subtract(storedAmount(run.bankTotal),storedAmount(run.bookTotal)),2,"half-even") { throw new Error("Invalid stored reconciliation run.") }
  }
}
fn parseRows(input,label) {
  text(input,label,50000); let output = []; let seen = new Set()
  for line in input.trim().split("\n") {
    if line.trim() == "" { continue }; let parts = line.split(",")
    if parts.length != 2 { throw new Error(label + ": use reference,amount on every line (no header).") }
    let reference = text(parts[0],"Reference",100); if seen.has(reference) { throw new Error(label + ": duplicate reference " + reference) }; seen.add(reference)
    output.push({reference:reference,amount:amount(parts[1].trim())}); if output.length > 500 { throw new Error("Maximum 500 rows per side.") }
  }; return output
}
fn reconcile(request) {
  let b = record(request.body); let label = text(b.label,"Run label",100); let bank = parseRows(b.bank,"Statement"); let book = parseRows(b.book,"Books")
  let differences = []; let matched = 0; let bankTotal = "0.00"; let bookTotal = "0.00"
  for item in bank {
    bankTotal = decimal.add(bankTotal,item.amount); let other = book.find(fn(row) { return row.reference == item.reference })
    if other == undefined { differences.push(item.reference + ": missing from books (" + item.amount + ")") }
    else if decimal.compare(item.amount,other.amount) != 0 { differences.push(item.reference + ": amount mismatch; statement " + item.amount + ", books " + other.amount) }
    else { matched += 1 }
  }
  for item in book { bookTotal = decimal.add(bookTotal,item.amount); if bank.find(fn(row) { return row.reference == item.reference }) == undefined { differences.push(item.reference + ": missing from statement (" + item.amount + ")") } }
  bankTotal = decimal.quantize(bankTotal,2,"half-even"); bookTotal = decimal.quantize(bookTotal,2,"half-even")
  let difference = decimal.quantize(decimal.subtract(bankTotal,bookTotal),2,"half-even")
  let run = {label:label, matched:matched, differences:differences, bankTotal:bankTotal, bookTotal:bookTotal, difference:difference, balanced:differences.length == 0}
  let next = {runs:state.runs.concat([run]).slice(-100)}; save(next); state = next
  return {run:run,message:str(matched) + " matched; " + str(differences.length) + " exceptions. Net difference: " + difference + ".",details:differences.join(" | ")}
}
fn page() {
  return ui.page({title:"Statement reconciliation",theme:"light",state:{label:"November review",bank:"INV-101,120.00\nINV-102,45.50",book:"INV-101,120.00\nINV-102,40.50",result:null,busy:false,problem:""},body:ui.stack([
    ui.text("FINANCE / WORLD CLASS TRACK",{class:"arya-eyebrow"}),ui.heading("Find every difference."),ui.text("Match statement and book references with exact decimal arithmetic. Paste one reference,amount per line, without a header."),
    ui.card([ui.form([
      ui.label("Run label","label"),ui.input({id:"label",bind:"label",required:true,maxlength:100}),
      ui.grid([ui.stack([ui.label("Statement rows","bank"),ui.textarea({id:"bank",bind:"bank",rows:8,required:true})]),ui.stack([ui.label("Book rows","book"),ui.textarea({id:"book",bind:"book",rows:8,required:true})])]),
      ui.button("Reconcile records",{type:"submit",disabled:ui.bind("busy")})
    ],{action:ui.request("/reconcile",{method:"POST",body:{label:ui.bind("label"),bank:ui.bind("bank"),book:ui.bind("book")},result:"result",pending:"busy",error:"problem"})})]),
    ui.card([ui.heading("Result",{level:2}),ui.text(ui.bind("result.message","Ready to compare."),{role:"status","aria-live":"polite"}),ui.text(ui.bind("result.details")),ui.text(ui.bind("problem"),{role:"alert"})]),
    ui.row([ui.heading("Recent runs",{level:2}),ui.link("Refresh history","/")]),
    ui.table([{key:"label",label:"Run"},{key:"matched",label:"Matched"},{key:"difference",label:"Net difference"},{key:"exceptionCount",label:"Exceptions"}],state.runs.slice().reverse().map(fn(run) { return Object.assign({},run,{exceptionCount:run.differences.length}) }),{caption:"Last 100 persisted reconciliation runs"})
  ])})
}
let server = web.serve(env.int("PORT", 8612), {
  "GET /": fn() { return web.response(200,page(),{"cache-control":"no-store"}) },
  "GET /health": fn() { return {status:"ok"} },
  "GET /runs": fn() { return state },
  "POST /reconcile": safe(reconcile)
}, {host: "127.0.0.1", root: process.cwd(), html: false, assets: false, maxBodyBytes: 1048576})
print("Listening at http://127.0.0.1:" + str(server.address().port))
for signal in ["SIGINT", "SIGTERM"] { process.onSignal(signal, async fn() { await web.shutdown(server) }, {once: true}) }
